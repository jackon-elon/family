page { background: #f7f8f5; color: #22302e; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
view, text, button, input, textarea, picker { box-sizing: border-box; }
button { border: 0; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 32rpx 30rpx 60rpx; }
.eyebrow { font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; color: #628079; }
.title { font-size: 52rpx; line-height: 1.22; font-weight: 750; letter-spacing: -2rpx; }
.subtitle { color: #687b76; line-height: 1.5; font-size: 26rpx; }
.section-title { font-size: 32rpx; font-weight: 730; margin: 0 0 20rpx; }
.card { background: #fff; border-radius: 30rpx; padding: 30rpx; box-shadow: 0 14rpx 34rpx rgba(19, 57, 44, .045); }
.card + .card { margin-top: 20rpx; }
.muted { color: #7c8b86; }
.small { font-size: 23rpx; }
.strong { font-weight: 700; }
.pill { display: inline-flex; align-items: center; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: 22rpx; line-height: 1.3; background: #e9f3ed; color: #27705a; }
.pill.warm { background: #fff0dd; color: #a56821; }
.pill.grey { background: #f0f3ef; color: #65766e; }
.btn { border-radius: 20rpx; min-height: 88rpx; line-height: 88rpx; padding: 0 28rpx; text-align: center; font-size: 28rpx; font-weight: 700; background: #1d684e; color: #fff; }
.btn.secondary { color: #1d684e; background: #e5f1e9; }
.btn.ghost { color: #294d42; background: #fff; border: 2rpx solid #dbe7df; }
.btn.danger { color: #bd4d4d; background: #fff1ef; }
.btn.small-btn { min-height: 64rpx; line-height: 64rpx; font-size: 24rpx; padding: 0 22rpx; }
.btn[disabled] { opacity: .48; }
.row { display: flex; align-items: center; }
.row.between { justify-content: space-between; }
.row.gap { gap: 16rpx; }
.grow { flex: 1; min-width: 0; }
.stack { display: flex; flex-direction: column; gap: 20rpx; }
.field { display: block; margin: 20rpx 0; }
.field-label { display: block; font-size: 25rpx; font-weight: 700; margin-bottom: 12rpx; }
.field-control { width: 100%; min-height: 82rpx; border-radius: 18rpx; background: #f6f8f5; padding: 20rpx 22rpx; color: #283d35; }
.field-control.placeholder { color: #98a8a0; }
.textarea { min-height: 150rpx; }
.divider { height: 1rpx; background: #edf1ec; margin: 24rpx 0; }
.avatar { width: 86rpx; height: 86rpx; border-radius: 28rpx; background: #dcebe1; color: #2b7057; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 750; flex-shrink: 0; overflow: hidden; }
.avatar image { width: 100%; height: 100%; }
.avatar.large { width: 130rpx; height: 130rpx; border-radius: 40rpx; font-size: 54rpx; }
.person-row { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; min-height: 102rpx; }
.person-row + .person-row { border-top: 1rpx solid #eef2ee; }
.person-name { font-size: 29rpx; font-weight: 720; }
.person-meta { margin-top: 6rpx; font-size: 23rpx; color: #70817a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chevron { color: #a3b2a9; font-size: 36rpx; }
.empty { text-align: center; padding: 70rpx 35rpx; color: #7b8c83; line-height: 1.55; }
.empty-icon { display: block; font-size: 66rpx; margin-bottom: 16rpx; }
.segmented { display: flex; padding: 7rpx; border-radius: 22rpx; background: #eaf0e9; gap: 6rpx; }
.segment { flex: 1; padding: 16rpx 12rpx; text-align: center; border-radius: 17rpx; color: #688076; font-size: 25rpx; font-weight: 700; }
.segment.active { color: #235d49; background: #fff; box-shadow: 0 3rpx 12rpx rgba(18, 60, 44, .08); }
.sticky-bottom { position: sticky; bottom: 0; padding: 24rpx 0 10rpx; background: linear-gradient(to bottom, rgba(247,248,245,0), #f7f8f5 35%); }
.error { margin: 20rpx 0; padding: 20rpx; border-radius: 18rpx; background: #fff1ef; color: #a13f3f; font-size: 24rpx; }
