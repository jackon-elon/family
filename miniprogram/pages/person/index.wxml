<view class="page profile-page" wx:if="{{person}}">
  <view class="profile-hero">
    <view class="avatar large profile-avatar"><image wx:if="{{person.photoUrl}}" src="{{person.photoUrl}}" mode="aspectFill"/><text wx:else>{{initial}}</text></view>
    <view class="profile-name">{{person.name}}</view>
    <view class="profile-nickname" wx:if="{{person.nickname}}">也叫 {{person.nickname}}</view>
    <view class="pill {{circle.type === 'family' ? '' : 'class-pill'}}">{{relationLabel}}</view>
    <view class="profile-city" wx:if="{{person.city}}">⌖ {{person.city}}</view>
  </view>

  <view class="card relation-card" wx:if="{{circle.type === 'family'}}">
    <view class="eyebrow">HOW WE CONNECT</view>
    <view class="section-title">{{person.isSelf ? '这就是你' : '你可以叫 TA：' + relationLabel}}</view>
    <view class="relation-path">{{relationPath || '暂无已记录的连接路径'}}</view>
    <view class="missing" wx:if="{{relationMissing}}">还需补充：{{relationMissing}}</view>
    <view class="small muted" wx:if="{{alternatives}}">也可称：{{alternatives}}</view>
  </view>

  <view class="card details-card">
    <view class="section-title">现在的 TA</view>
    <view class="detail-row" wx:for="{{rows}}" wx:key="label"><text class="detail-label">{{item.label}}</text><text class="detail-value">{{item.value}}</text></view>
    <view class="empty-details" wx:if="{{!rows.length}}">还没有填写更多资料。</view>
    <view class="update-time">最近确认：{{updated}}</view>
  </view>

  <view class="card contact-card" wx:if="{{person.phone || person.wechatId}}"><view class="section-title">联系 TA</view><view class="detail-row" wx:if="{{person.phone}}"><text class="detail-label">手机号</text><text class="detail-value">{{person.phone}}</text><text class="text-action" bindtap="onCall">拨打</text></view><view class="detail-row" wx:if="{{person.wechatId}}"><text class="detail-label">微信号</text><text class="detail-value">{{person.wechatId}}</text><text class="text-action" bindtap="onCopyWechat">复制</text></view></view>

  <view class="profile-actions"><button class="btn" wx:if="{{canEdit}}" bindtap="onEdit">{{person.isSelf ? '编辑我的资料' : '编辑人物卡'}}</button><button class="btn secondary" wx:if="{{person.isSelf}}" bindtap="onPrivacy">资料可见范围</button><button class="btn secondary" wx:if="{{canClaim}}" bindtap="onClaim">申请认领这张卡</button><button class="btn ghost" bindtap="onSuggest">建议更正资料或关系</button><button class="btn danger" wx:if="{{isAdmin && !person.isClaimed}}" bindtap="onDelete">删除这张人物卡</button></view>
</view>
