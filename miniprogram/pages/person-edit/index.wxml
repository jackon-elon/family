<view class="page edit-page">
  <view class="eyebrow">PERSON CARD</view><view class="title">{{isNew ? (createMode === 'self' ? '创建我的人物卡' : '添加未加入的人物卡') : '更新人物卡'}}</view><view class="subtitle intro">{{isNew && createMode === 'self' ? '先确认圈里没有你的卡，再填写自己的资料。' : '先填知道的部分，其他信息以后慢慢补上。'}}</view>
  <view class="card self-create-guide" wx:if="{{isNew && createMode === 'self'}}"><view class="strong">已有卡请先认领</view><view class="small muted">管理员或家人可能已经把你放进关系网。认领已有卡后，原来的关系就能接到你身上。</view><button class="btn secondary" bindtap="onReviewExisting">查看已有卡</button><view wx:if="{{pendingClaim}}" class="pending-warning">你的认领申请还在审核中，暂时不能新建本人卡。</view></view>
  <view class="card self-create-guide" wx:if="{{isNew && createMode === 'other'}}"><view class="strong">这是一张未加入的人物卡</view><view class="small muted">添加人物不会邀请 TA 加入。本人以后可通过邀请申请加入并认领。</view></view>
  <view class="card similar-warning" wx:if="{{isNew && createMode === 'self' && similarCards.length}}"><view class="strong">找到可能是你的已有卡</view><view class="small muted" wx:for="{{similarCards}}" wx:key="id">{{item.name}}{{item.nickname ? '（' + item.nickname + '）' : ''}}</view><button class="btn secondary" bindtap="onReviewExisting">先去核对并认领</button></view>
  <view class="card form-card">
    <label class="field" wx:if="{{editable.name}}"><text class="field-label">姓名或圈内称呼 *</text><input class="field-control" value="{{form.name}}" placeholder="TA 叫什么？" maxlength="30" data-field="name" bindinput="onInput" /></label>
    <label class="field" wx:if="{{editable.gender}}"><text class="field-label">性别（用于计算称呼）</text><picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGender"><view class="field-control {{genderIndex ? '' : 'placeholder'}}">{{genderOptions[genderIndex]}} ▾</view></picker></label>
    <label class="field" wx:if="{{editable.birthOrder}}"><text class="field-label">同性别兄弟姐妹中的排行</text><input class="field-control" value="{{form.birthOrder}}" type="number" placeholder="例如：1、2；不确定可留空" maxlength="2" data-field="birthOrder" bindinput="onInput" /><text class="hint">用来计算大姨、二姨等叫法；长幼关系也可单独录入。</text></label>
    <view wx:if="{{!canPrivate}}" class="hint">未认领的人物卡先只填维持关系所需的信息；照片、电话和城市由本人认领后填写。</view>
    <block wx:if="{{canPrivate}}">
      <label class="field" wx:if="{{editable.nickname}}"><text class="field-label">昵称</text><input class="field-control" value="{{form.nickname}}" placeholder="例如：满满" maxlength="30" data-field="nickname" bindinput="onInput" /></label>
      <view class="field" wx:if="{{editable.photoFileId}}"><text class="field-label">照片</text><view class="row gap"><view class="avatar large"><image wx:if="{{form.photoUrl}}" src="{{form.photoUrl}}" mode="aspectFill"/><text wx:else>{{initial}}</text></view><button class="btn secondary small-btn" bindtap="onChoosePhoto">选择照片</button></view></view>
      <view class="field" wx:if="{{editable.city}}"><text class="field-label">所在城市</text><picker mode="selector" range="{{cityLabels}}" value="{{cityIndex}}" bindchange="onCity"><view class="field-control {{cityIndex ? '' : 'placeholder'}}">{{cityIndex ? cityLabels[cityIndex] : '选择常见城市（可选）'}} ▾</view></picker><text class="hint">也可以直接填写下面的城市；只记录城市，不采集实时位置或住址。</text></view>
      <label class="field" wx:if="{{editable.country}}"><text class="field-label">国家 / 地区</text><input class="field-control" value="{{form.country}}" placeholder="例如：中国、加拿大" maxlength="40" data-field="country" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.province}}"><text class="field-label">省 / 州</text><input class="field-control" value="{{form.province}}" placeholder="可选" maxlength="40" data-field="province" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.city}}"><text class="field-label">城市</text><input class="field-control" value="{{form.city}}" placeholder="例如：昆明、奥斯陆" maxlength="40" data-field="city" bindinput="onInput" /></label>
      <view class="field" wx:if="{{editable.city}}"><button class="btn secondary location-button" bindtap="onChooseCityPoint">在地图上选城市中心</button><text class="hint">地图中心只保存约 10 公里精度的城市代表点，不读取实时位置或家庭住址。手动输入陌生城市后，请在地图上标一下位置。</text></view>
      <label class="field" wx:if="{{editable.status}}"><text class="field-label">目前状态</text><picker mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatus"><view class="field-control {{statusIndex ? '' : 'placeholder'}}">{{statusOptions[statusIndex]}} ▾</view></picker></label>
      <label class="field" wx:if="{{editable.school}}"><text class="field-label">学校</text><input class="field-control" value="{{form.school}}" placeholder="在读或曾就读的学校" maxlength="50" data-field="school" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.industry}}"><text class="field-label">行业</text><input class="field-control" value="{{form.industry}}" placeholder="例如：教育、设计、医疗" maxlength="30" data-field="industry" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.occupation}}"><text class="field-label">职业</text><input class="field-control" value="{{form.occupation}}" placeholder="例如：教师、设计师" maxlength="40" data-field="occupation" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.bio}}"><text class="field-label">近况</text><textarea class="field-control textarea" value="{{form.bio}}" placeholder="最近过得怎么样？" maxlength="200" data-field="bio" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.phone}}"><text class="field-label">手机号</text><input class="field-control" value="{{form.phone}}" type="text" placeholder="仅本人可见，除非你主动开放" maxlength="20" data-field="phone" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.wechatId}}"><text class="field-label">微信号</text><input class="field-control" value="{{form.wechatId}}" placeholder="仅本人可见，除非你主动开放" maxlength="40" data-field="wechatId" bindinput="onInput" /></label>
    </block>
  </view>
  <view class="sticky-bottom"><button class="btn" disabled="{{saving}}" bindtap="onSave">{{saving ? '正在保存…' : '保存人物卡'}}</button></view>
</view>
