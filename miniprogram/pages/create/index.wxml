<view class="page create-page">
  <view class="title">新建一份亲友录</view>
  <view class="subtitle intro">家人和同学分开放，不同班级也各有一份。</view>

  <view class="section-title">和谁相聚？</view>
  <view class="choice-row">
    <view class="choice {{type === 'family' ? 'selected' : ''}}" data-type="family" bindtap="chooseType"><view class="choice-icon family">家</view><view class="choice-title">家人录</view><view class="choice-sub">认亲属、记称呼</view></view>
    <view class="choice {{type === 'classmate' ? 'selected' : ''}}" data-type="classmate" bindtap="chooseType"><view class="choice-icon class">同</view><view class="choice-title">同窗录</view><view class="choice-sub">找同学、看城市</view></view>
  </view>

  <view class="card form-card">
    <label class="field"><text class="field-label">{{type === 'family' ? '家人录名称' : '同窗录名称'}} *</text><input disabled="{{saving || createdCircleId}}" class="field-control" value="{{name}}" placeholder="{{type === 'family' ? '例如：陈家亲友' : '例如：青禾二班'}}" maxlength="32" data-field="name" bindinput="onInput" /></label>
    <block wx:if="{{type === 'classmate'}}">
      <label class="field"><text class="field-label">学校 *</text><input disabled="{{saving || createdCircleId}}" class="field-control" value="{{school}}" placeholder="例如：青禾中学" maxlength="40" data-field="school" bindinput="onInput" /></label>
      <label class="field"><text class="field-label">届别 / 入学年份 *</text><input disabled="{{saving || createdCircleId}}" class="field-control" value="{{cohort}}" placeholder="例如：2017 届" maxlength="20" data-field="cohort" bindinput="onInput" /></label>
      <label class="field"><text class="field-label">班级 *</text><input disabled="{{saving || createdCircleId}}" class="field-control" value="{{className}}" placeholder="例如：高三二班" maxlength="30" data-field="className" bindinput="onInput" /></label>
      <view class="form-hint">一份同窗录只对应一个班级，方便管理员核对申请。</view>
    </block>
  </view>

  <view class="form-hint">建好后可以先整理资料，再用微信邀请{{type === 'family' ? '家人' : '同学'}}加入。</view>
  <view class="sticky-bottom"><button class="btn" disabled="{{saving}}" bindtap="onSubmit">{{saving ? '正在创建…' : createdCircleId ? (type === 'family' ? '打开家人录' : '打开同窗录') : type === 'family' ? '创建家人录' : '创建同窗录'}}</button></view>
</view>
