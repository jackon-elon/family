<view class="page apply-page">
  <view class="eyebrow">INVITATION</view><view class="title">{{statusOnly ? '我的加入申请' : '有人想和你保持联系'}}</view>
  <view class="card error-card" wx:if="{{error}}"><view class="error-title">暂时无法查看</view><view class="subtitle">{{error}}</view><button class="btn status-action" bindtap="onRetry">重试</button><button class="btn secondary status-action" bindtap="onHome">返回首页</button></view>
  <view class="card status-card" wx:if="{{!error && (previewLoading || (statusOnly && checking && !application))}}">正在读取邀请信息…</view>
  <view class="card invite-preview" wx:if="{{circle && !statusOnly && !error && !previewLoading}}"><view class="preview-mark">{{circle.type === 'family' ? '家' : '同'}}</view><view class="preview-name">{{circle.name}}</view><view class="pill {{circle.type === 'family' ? '' : 'class-pill'}}">{{circle.type === 'family' ? '家庭圈' : '同学圈'}}</view><view class="small muted class-meta" wx:if="{{circle.type === 'classmate'}}">{{circle.school}} · {{circle.cohort}} · {{circle.className}}</view><view class="divider"></view><view class="small muted">有效期至 {{expiryText}}。申请通过前看不到圈内资料。</view></view>

  <view wx:if="{{!error && !previewLoading && status && status !== 'active' && !submitted && !statusOnly}}" class="card status-card"><view class="status-title">{{status === 'expired' ? '邀请已过期' : status === 'revoked' ? '邀请已撤销' : '邀请已使用'}}</view><view class="subtitle">请联系邀请人，让管理员重新生成一份邀请。</view></view>
  <view wx:elif="{{!error && submitted}}" class="card status-card"><view class="success-icon">{{application && application.status === 'approved' && application.canEnter !== false ? '✓' : '·'}}</view><view class="status-title">{{applicationTitle}}</view><view class="subtitle">{{applicationMessage}}</view><view class="small muted status-meta" wx:if="{{application}}">{{application.circleName || (circle && circle.name) || '受邀圈子'}} · {{applicationDate}}</view><button wx:if="{{application && application.status === 'approved' && application.canEnter !== false}}" class="btn status-action" bindtap="onOpenCircle">进入圈子</button><button wx:else class="btn secondary status-action" loading="{{checking}}" bindtap="loadMyStatus">刷新审核状态</button><button class="home-action" bindtap="onHome">返回首页</button></view>
  <view wx:elif="{{!error && !previewLoading && status === 'active'}}" class="card apply-form"><view class="section-title">申请加入</view><view class="small muted form-intro">先让管理员认出你。加入后再确认本人卡；这里不用填写“我是某人的伯父”等固定称呼。</view><label class="field"><text class="field-label">圈内常用姓名 *</text><input class="field-control" value="{{name}}" placeholder="管理员认识你的名字" maxlength="30" data-field="name" bindinput="onInput" /></label><label class="field"><text class="field-label">身份说明{{circle.type === 'classmate' ? ' *' : '（建议填写）'}}</text><textarea class="field-control textarea" value="{{note}}" placeholder="{{circle.type === 'classmate' ? '例如：青禾中学 2020 届三班，王宁' : '例如：谁邀请了你，或你认识圈里的哪位家人'}}" maxlength="120" data-field="note" bindinput="onInput" /></label><button class="btn" disabled="{{submitting}}" bindtap="onSubmit">{{submitting ? '正在提交…' : '提交加入申请'}}</button><view class="small muted privacy-note">提交申请不代表自动加入。管理员核对后才会开放圈内资料。</view></view>
</view>
