.picker-page { padding-bottom: 40rpx; }
.intro { margin: 16rpx 0 24rpx; }
.choice-summary { margin-bottom: 24rpx; padding: 22rpx 26rpx; }
.choice-summary__value { margin: 8rpx 0; font-size: 29rpx; color: #1d503e; font-weight: 700; }
.picker-heading { margin: 22rpx 0 14rpx; }
.picker-back { color: #277354; font-size: 25rpx; padding: 8rpx; }
.choice-list { padding: 0 24rpx; box-sizing: border-box; }
.choice-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; border-bottom: 1rpx solid #e8eee8; font-size: 29rpx; color: #213e32; }
.choice-row:last-child { border-bottom: 0; }
.choice-row.is-selected { color: #16704b; font-weight: 700; }
.choice-arrow { color: #719989; font-size: 34rpx; padding-left: 16rpx; }
.custom-entry { margin: 22rpx 4rpx 28rpx; color: #287756; font-size: 25rpx; text-align: center; padding: 12rpx; }
.custom-form { padding: 14rpx 24rpx; }
.custom-tip { line-height: 1.6; margin-top: 14rpx; }
