.circle-page { padding-top: 20rpx; }
.self-prompt { display: flex; align-items: center; gap: 12rpx; padding: 20rpx; margin: 20rpx 0 0; border-radius: 19rpx; background: #fff7e8; }.self-prompt .btn { flex-shrink: 0; }.self-prompt .small { margin-top: 5rpx; line-height: 1.4; }
.circle-head { border-radius: 34rpx; background: #e4eee4; padding: 36rpx; position: relative; overflow: hidden; }
.circle-head::after { content: ''; position: absolute; width: 230rpx; height: 230rpx; border-radius: 50%; background: #d4e6d7; right: -70rpx; bottom: -115rpx; }
.circle-head .title { font-size: 43rpx; margin: 20rpx 0 9rpx; position: relative; z-index: 1; }
.circle-head .subtitle,.head-footer { position: relative; z-index: 1; }
.class-pill { background: #e6e9fa; color: #5b68a2; }
.head-footer { margin-top: 30rpx; color: #658171; font-size: 23rpx; }
.main-tabs { margin: 25rpx 0; }
.search-box { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 0 22rpx; height: 82rpx; margin-bottom: 22rpx; }
.search-box input { flex: 1; font-size: 25rpx; }
.search-icon { font-size: 45rpx; color: #a1b1a5; margin-right: 13rpx; line-height: 1; }
.viewpoint-bar { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 7rpx 24rpx; }
.viewpoint-name { font-weight: 730; margin-top: 3rpx; }
.viewpoint-select,.text-action { color: #25805d; font-size: 24rpx; font-weight: 700; }
.network-center { position: relative; overflow: hidden; height: 350rpx; border-radius: 34rpx; background: radial-gradient(circle at 50% 50%, #dff3e5, #ecf7ed 70%); display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 33rpx; }
.center-orbit { position: absolute; border: 2rpx solid rgba(75, 151, 103, .16); border-radius: 50%; }
.orbit-one { width: 310rpx; height: 310rpx; }.orbit-two { width: 500rpx; height: 500rpx; }
.center-label { z-index: 1; font-size: 21rpx; color: #608f72; font-weight: 700; letter-spacing: 2rpx; }
.center-avatar { z-index: 1; width: 92rpx; height: 92rpx; border-radius: 30rpx; display: flex; align-items: center; justify-content: center; background: #2d8a61; color: #fff; font-size: 38rpx; font-weight: 720; margin: 13rpx 0; box-shadow: 0 14rpx 26rpx rgba(20, 105, 63, .2); }
.center-name { z-index: 1; font-size: 31rpx; font-weight: 750; }.center-sub { z-index: 1; font-size: 22rpx; color: #789184; margin-top: 5rpx; }
.network-heading,.list-heading { margin: 30rpx 3rpx 11rpx; align-items: baseline; }.network-heading .section-title,.list-heading .section-title { margin: 0; }
.network-list { padding-left: 22rpx; }
.network-item { position: relative; display: flex; align-items: center; gap: 18rpx; padding: 15rpx 19rpx 15rpx 33rpx; background: #fff; border-radius: 24rpx; margin-bottom: 13rpx; box-shadow: 0 6rpx 22rpx rgba(25, 64, 44, .04); }
.network-connector { position: absolute; top: -16rpx; bottom: -16rpx; left: -22rpx; width: 2rpx; background: #b9d9c4; }
.connector-dot { position: absolute; left: -7rpx; top: 55rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #5fae7b; border: 3rpx solid #f7f8f5; }
.network-item .person-name { font-size: 27rpx; }.network-item .pill { padding: 5rpx 12rpx; font-size: 20rpx; }
.expand-link { text-align: center; padding: 25rpx; color: #2b7958; font-size: 24rpx; font-weight: 700; }
.filter-row { display: flex; gap: 12rpx; overflow-x: auto; white-space: nowrap; margin-bottom: 25rpx; }
.filter-chip { border-radius: 999rpx; background: #eaf1eb; color: #557064; font-size: 22rpx; padding: 13rpx 18rpx; }
.list-card { padding: 12rpx 26rpx; }
.map-heading { margin: 33rpx 2rpx 21rpx; align-items: end; }.map-heading .section-title { margin-bottom: 2rpx; }
.map-toggle { display: flex; border-radius: 15rpx; background: #e8efea; padding: 4rpx; }.map-toggle text { color: #71857a; padding: 11rpx 18rpx; font-size: 22rpx; border-radius: 12rpx; }.map-toggle .active { background: #fff; color: #2d7456; font-weight: 700; }
.map-board { position: relative; overflow: hidden; height: 430rpx; border-radius: 28rpx; background: #cde7ed; }
.map-board.china { background: #cfebea; }
.map-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.25) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(255,255,255,.25) 1rpx, transparent 1rpx); background-size: 90rpx 90rpx; }
.land,.china-land { position: absolute; background: #e5eed9; opacity: .95; filter: drop-shadow(0 4rpx 4rpx rgba(23, 105, 93, .06)); }
.land { border-radius: 55% 40% 50% 40%; }.north-america { left: 7%; top: 15%; width: 26%; height: 24%; transform: rotate(-15deg); }.south-america { left: 28%; top: 47%; width: 11%; height: 37%; transform: rotate(16deg); }.europe { left: 48%; top: 19%; width: 15%; height: 17%; }.africa { left: 47%; top: 39%; width: 15%; height: 32%; transform: rotate(-8deg); }.asia { left: 59%; top: 12%; width: 34%; height: 37%; transform: rotate(8deg); }.oceania { left: 79%; top: 66%; width: 15%; height: 15%; }
.china-land { border-radius: 48%; }.china-land.west { left: 12%; top: 17%; width: 50%; height: 55%; transform: rotate(-13deg); }.china-land.east { left: 42%; top: 25%; width: 45%; height: 50%; transform: rotate(12deg); }.china-land.south { left: 47%; top: 60%; width: 21%; height: 23%; }
.region { position: absolute; font-size: 18rpx; color: #6b9c98; letter-spacing: 2rpx; }.region-na { left: 14%; top: 18%; }.region-eu { left: 51%; top: 21%; }.region-as { left: 71%; top: 23%; }.region-oc { left: 80%; top: 72%; }.region-china { left: 33%; top: 45%; font-size: 26rpx; color: #8ab5a0; }
.map-dot { position: absolute; display: flex; flex-direction: column; align-items: center; transform: translate(-50%, -50%); z-index: 2; min-width: 70rpx; }
.dot-count { width: 47rpx; height: 47rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #207457; color: #fff; border: 5rpx solid #fff; box-shadow: 0 4rpx 12rpx rgba(10, 88, 58, .2); font-size: 20rpx; font-weight: 750; }
.dot-label { white-space: nowrap; padding: 3rpx 8rpx; border-radius: 7rpx; color: #164c3b; background: rgba(255,255,255,.84); font-size: 19rpx; font-weight: 720; margin-top: 2rpx; }
.map-empty { position: absolute; top: 45%; left: 0; right: 0; text-align: center; color: #6b9085; font-size: 26rpx; }
.map-note { color: #5b806c; background: #e8f2e7; border-radius: 15rpx; padding: 16rpx 18rpx; margin-top: 15rpx; font-size: 23rpx; }
.city-sheet { margin-top: 22rpx; }.city-sheet .section-title { margin: 0; }
.city-heading { margin-top: 30rpx; }.city-row { display: flex; align-items: center; gap: 13rpx; padding: 19rpx 0; border-bottom: 1rpx solid #eef2ee; font-weight: 660; }.city-row:last-child { border-bottom: 0; }.city-pin { color: #3b916a; }
.bottom-actions { display: flex; gap: 13rpx; margin-top: 40rpx; }.bottom-actions .btn { flex: 1; font-size: 24rpx; }
.leave-link { text-align: center; padding: 30rpx 0 12rpx; color: #a16b65; font-size: 23rpx; }
