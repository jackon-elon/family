.cosmos-wrap { overflow: hidden; border-radius: 32rpx; background: #10192f; color: #f5f7ff; box-shadow: 0 18rpx 42rpx rgba(12, 29, 57, .18); }
.cosmos-header { height: 72rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; background: #10192f; border-bottom: 1rpx solid rgba(255, 255, 255, .11); }
.cosmos-kicker { color: #a6b5da; font-size: 22rpx; font-weight: 700; letter-spacing: 1rpx; }
.cosmos-counter { color: #c2d7ff; font-size: 21rpx; }
.cosmos-vertical { height: 650rpx; width: 100%; }
.cosmos-horizontal { width: 100%; }
.cosmos-board { position: relative; overflow: hidden; background-color: #10192f; background-image: radial-gradient(circle at 14% 20%, rgba(143, 171, 235, .8) 1rpx, transparent 2rpx), radial-gradient(circle at 77% 68%, rgba(206, 219, 255, .76) 1rpx, transparent 2rpx), radial-gradient(circle at 42% 82%, rgba(226, 202, 255, .65) 1rpx, transparent 2rpx); background-size: 205rpx 173rpx, 279rpx 227rpx, 316rpx 281rpx; }
.space-glow { position: absolute; border-radius: 50%; pointer-events: none; }
.space-glow-a { left: 7%; top: 9%; width: 48%; height: 43%; background: radial-gradient(circle, rgba(70, 104, 172, .17), transparent 70%); }
.space-glow-b { right: 4%; bottom: 7%; width: 53%; height: 48%; background: radial-gradient(circle, rgba(99, 73, 154, .13), transparent 72%); }
.orbit { position: absolute; border-radius: 50%; border: 1rpx solid rgba(155, 181, 225, .14); pointer-events: none; }
.relation-line { position: absolute; height: 2rpx; transform-origin: left center; background: rgba(112, 194, 224, .48); pointer-events: none; }
.relation-spouse { height: 3rpx; background: rgba(245, 185, 181, .56); }
.relation-sibling { background: rgba(186, 166, 242, .5); }
.star-node { position: absolute; z-index: 2; width: 150rpx; display: flex; flex-direction: column; align-items: center; transform: translate(-50%, -50%); text-align: center; }
.planet-shell { position: relative; width: 88rpx; height: 88rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; font-size: 37rpx; font-weight: 740; color: #fff; background: radial-gradient(circle at 32% 28%, #b6dfef, #5074b4 73%); border: 4rpx solid rgba(255, 255, 255, .7); box-shadow: 0 0 0 10rpx rgba(99, 158, 227, .1), 0 9rpx 25rpx rgba(0, 0, 0, .25); }
.planet-shell image { width: 100%; height: 100%; border-radius: 50%; }
.tone-1 .planet-shell { background: radial-gradient(circle at 30% 27%, #d7c5ef, #846db3 74%); box-shadow: 0 0 0 10rpx rgba(169, 125, 215, .1), 0 9rpx 25rpx rgba(0, 0, 0, .25); }
.tone-2 .planet-shell { background: radial-gradient(circle at 30% 27%, #c6e6d8, #569c8c 74%); box-shadow: 0 0 0 10rpx rgba(99, 195, 158, .1), 0 9rpx 25rpx rgba(0, 0, 0, .25); }
.tone-3 .planet-shell { background: radial-gradient(circle at 30% 27%, #f5d8b9, #c08270 74%); box-shadow: 0 0 0 10rpx rgba(223, 154, 110, .1), 0 9rpx 25rpx rgba(0, 0, 0, .25); }
.is-focus .planet-shell { width: 108rpx; height: 108rpx; font-size: 43rpx; border-color: #d7edff; box-shadow: 0 0 0 12rpx rgba(118, 188, 255, .19), 0 0 38rpx rgba(158, 218, 255, .51); }
.is-self .planet-shell { background: radial-gradient(circle at 30% 25%, #fff6ce, #f6bc63 66%, #e38c70); border-color: #fff8dd; color: #5c3a2c; box-shadow: 0 0 0 12rpx rgba(255, 215, 135, .2), 0 0 42rpx rgba(255, 195, 92, .58); }
.is-unlinked .planet-shell { opacity: .72; border-style: dashed; }
.star-name { max-width: 150rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 9rpx; padding: 2rpx 8rpx; border-radius: 8rpx; background: rgba(11, 20, 42, .72); color: #fff; font-size: 27rpx; line-height: 1.25; font-weight: 750; text-shadow: 0 2rpx 8rpx rgba(3, 8, 22, .7); }
.star-label { max-width: 150rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 4rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: rgba(32, 51, 91, .94); border: 1rpx solid rgba(169, 197, 245, .36); color: #dce7ff; font-size: 21rpx; line-height: 1.25; }
.is-self .star-label { color: #ffdf98; }
.cosmos-footer { min-height: 63rpx; padding: 10rpx 22rpx 13rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: #9fb0d4; font-size: 19rpx; background: #10192f; border-top: 1rpx solid rgba(255, 255, 255, .1); }
.cosmos-empty { height: 390rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #f1f5ff; font-size: 26rpx; }
.empty-orbit { width: 100rpx; height: 100rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(210, 225, 255, .3); border-radius: 50%; font-size: 54rpx; color: #b7d4f7; margin-bottom: 20rpx; }
.empty-sub { color: #9dadd3; font-size: 21rpx; margin-top: 12rpx; }
