<view class="page edit-page" wx:if="{{!loading && !loadError}}">
  <view class="title">{{isNew ? (createMode === 'self' ? '填写我的资料' : circle.type === 'family' ? '添加家人' : '添加同学') : '编辑资料'}}</view>
  <view class="subtitle intro">{{selfProfileReady ? (circle.type === 'family' && relationTargetIds.length ? '已填好的资料带过来了，选好家人关系即可保存；不清楚也可稍后补。' : '已填好的资料带过来了，可以直接保存。') : '先填基本资料，其他信息以后也能补充。'}}</view>
  <view class="small muted edit-scope-note" wx:if="{{isAdmin && !isNew && !isSelf}}">只修改这份{{circle.type === 'family' ? '家人录' : '同窗录'}}中的资料。</view>
  <view class="existing-entry" wx:if="{{isNew && createMode === 'self'}}" bindtap="onReviewExisting">{{circle.type === 'family' ? '家人' : '同学'}}已经添加过我？<text>查看已有资料 ›</text></view>
  <view class="pending-warning" wx:if="{{isNew && createMode === 'self' && pendingClaim}}">已提交，等待管理员确认，暂时不用重复添加。</view>
  <view class="card similar-warning" wx:if="{{isNew && createMode === 'self' && similarCards.length}}">
    <view class="strong">这里可能已经有你的资料</view>
    <view class="small muted" wx:for="{{similarCards}}" wx:key="id">{{item.name}}{{item.nickname ? '（' + item.nickname + '）' : ''}}</view>
    <button class="btn secondary small-btn" disabled="{{saving || savedPersonId}}" bindtap="onReviewExisting">看看是不是我</button>
  </view>
  <view class="card form-card basic-card">
    <view class="form-heading">基本资料<text>必填</text></view>
    <label class="field" wx:if="{{editable.name}}"><text class="field-label">姓名或称呼</text><input disabled="{{saving || savedPersonId}}" class="field-control" value="{{form.name}}" placeholder="例如：李明" maxlength="30" data-field="name" bindinput="onInput" /></label>
    <view class="field relation-field" wx:if="{{isNew && circle.type === 'family' && relationTargetIds.length}}">
      <view class="relation-heading"><text class="field-label">与家人的关系</text><button class="relation-help-link" bindtap="onToggleRelationHelp">怎么添加？</button></view>
      <view class="relation-help" wx:if="{{relationHelpExpanded}}">
        <text>妈妈还没加入：先选自己，再选“TA 是我的妈妈”，直接保存她的资料，不用等她注册。</text>
        <text>远亲已在这里：选择与 TA 直接有关的家人。中间的人还没添加，可以先添加；关系不清楚就稍后补。</text>
        <text>之后到“我的 → 管理 → 关系”连接已有家人。</text>
      </view>
      <view wx:if="{{!deferRelation}}">
        <picker disabled="{{saving || savedPersonId}}" mode="selector" range="{{relationTargetNames}}" value="{{relationTargetIndex}}" bindchange="onRelationTarget"><view class="field-control picker-control {{relationTargetIndex ? '' : 'placeholder'}}"><text>{{relationTargetNames[relationTargetIndex]}}</text><text class="picker-arrow">⌄</text></view></picker>
        <picker disabled="{{saving || savedPersonId}}" class="relation-picker" wx:if="{{relationTargetIndex > 0}}" mode="selector" range="{{relationKindOptions}}" value="{{relationKindIndex}}" bindchange="onRelationKind"><view class="field-control picker-control {{relationKindIndex ? '' : 'placeholder'}}"><text>{{relationKindOptions[relationKindIndex]}}</text><text class="picker-arrow">⌄</text></view></picker>
        <text class="hint">选一位已有家人，对方没用过小程序也可以。</text>
      </view>
      <view class="defer-relation"><view><text>稍后补关系</text><text class="hint">{{deferRelation ? '先保存人物，显示在“关系待补充”区。' : '暂时说不清关系时可以开启。'}}</text></view><switch checked="{{deferRelation}}" bindchange="onDeferRelation" disabled="{{saving}}" color="#526f60" /></view>
    </view>
    <text class="hint first-person-hint" wx:if="{{isNew && circle.type === 'family' && !relationTargetIds.length}}">这是第一位家人，之后添加的人再与 TA 建立关系。</text>
    <view class="field" wx:if="{{editable.city}}"><text class="field-label">所在城市</text><button class="field-control location-button picker-control {{form.city ? '' : 'placeholder'}}" disabled="{{saving || savedPersonId}}" bindtap="onChooseCityPoint"><text>{{form.city ? (form.country + ' · ' + (form.province && form.province !== form.city ? form.province + ' · ' : '') + form.city) : '按国家、省州、城市选择'}}</text><text class="picker-arrow">›</text></button></view>
    <view class="field birthday-field" wx:if="{{editable.birthday}}">
      <text class="field-label">生日</text>
      <view class="row gap birthday-pickers">
        <picker disabled="{{saving || savedPersonId}}" mode="selector" range="{{calendarOptions}}" value="{{calendarIndex}}" bindchange="onCalendar"><view class="field-control">{{calendarOptions[calendarIndex]}} ⌄</view></picker>
        <picker disabled="{{saving || savedPersonId}}" mode="selector" range="{{monthOptions}}" value="{{monthIndex}}" bindchange="onBirthMonth"><view class="field-control {{monthIndex >= 0 ? '' : 'placeholder'}}">{{monthIndex >= 0 ? monthOptions[monthIndex] : '月份'}} ⌄</view></picker>
        <picker disabled="{{saving || savedPersonId}}" mode="selector" range="{{dayOptions}}" value="{{dayIndex}}" bindchange="onBirthDay"><view class="field-control {{dayIndex >= 0 ? '' : 'placeholder'}}">{{dayIndex >= 0 ? dayOptions[dayIndex] : '日期'}} ⌄</view></picker>
      </view>
      <view class="leap-row" wx:if="{{calendarIndex === 1}}"><text>农历闰月</text><switch disabled="{{saving || savedPersonId}}" checked="{{leapMonth}}" bindchange="onLeapMonth" color="#258660" /></view>
      <input disabled="{{saving || savedPersonId}}" class="field-control birth-year" value="{{form.birthYear}}" type="number" placeholder="出生年份（选填，可自动判断长幼）" maxlength="4" data-field="birthYear" bindinput="onInput" />
      <text class="hint">{{calendarIndex === 1 ? '每年自动换算为对应的阳历日期。' : '每年自动更新生日日程。'}}</text>
    </view>
  </view>
  <view class="card optional-card" id="optional-section">
    <button class="optional-toggle" bindtap="onToggleOptional"><view><text class="optional-title">更多资料</text><text class="optional-description">照片、联系方式、近况等 · 选填</text></view><text class="optional-arrow">{{optionalExpanded ? '收起 −' : '展开 ＋'}}</text></button>
    <view class="optional-content" wx:if="{{optionalExpanded}}">
      <view class="field photo-field" wx:if="{{editable.photoFileId}}"><text class="field-label">照片</text><view class="row gap photo-row"><view class="avatar photo-preview"><image wx:if="{{form.photoUrl}}" src="{{form.photoUrl}}" mode="aspectFill"/><text wx:else>{{initial}}</text></view><button class="btn secondary small-btn photo-button" disabled="{{photoChecking || saving || savedPersonId}}" bindtap="onChoosePhoto">{{photoChecking ? '正在处理…' : form.photoUrl || hasPhoto ? '更换照片' : '选择照片'}}</button></view><text class="hint" wx:if="{{photoSelected}}">照片将随资料一起保存。</text></view>
      <label class="field" wx:if="{{editable.nickname}}"><text class="field-label">昵称</text><input disabled="{{saving || savedPersonId}}" class="field-control" value="{{form.nickname}}" placeholder="平时怎么叫 TA" maxlength="30" data-field="nickname" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.gender}}"><text class="field-label">性别</text><picker disabled="{{saving || savedPersonId}}" mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGender"><view class="field-control picker-control"><text>{{genderOptions[genderIndex]}}</text><text class="picker-arrow">⌄</text></view></picker></label>
      <label class="field" wx:if="{{editable.phone}}"><text class="field-label">{{isNew && editable.matchPhone ? 'TA 的手机号' : '联系电话'}}</text><input disabled="{{saving || savedPersonId}}" class="field-control" value="{{form.phone}}" type="text" placeholder="填写手机号" maxlength="20" data-field="phone" bindinput="onInput" /><text class="hint" wx:if="{{isNew && editable.matchPhone}}">TA 受邀加入后，用这个号码找到自己的资料。</text></label>
      <label class="field" wx:if="{{!isNew && createMode === 'other' && editable.matchPhone}}"><text class="field-label">微信登录使用的手机号</text><input disabled="{{saving || savedPersonId}}" class="field-control" value="{{form.matchPhone}}" type="text" placeholder="填写 TA 登录微信小程序时使用的号码" maxlength="18" data-field="matchPhone" bindinput="onInput" /><text class="hint">用于 TA 加入后找到自己的资料。</text></label>
      <label class="field" wx:if="{{editable.wechatId}}"><text class="field-label">微信号</text><input disabled="{{saving || savedPersonId}}" class="field-control" value="{{form.wechatId}}" placeholder="填写微信号" maxlength="40" data-field="wechatId" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.status}}"><text class="field-label">目前状态</text><picker disabled="{{saving || savedPersonId}}" mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatus"><view class="field-control picker-control"><text>{{statusOptions[statusIndex]}}</text><text class="picker-arrow">⌄</text></view></picker></label>
      <label class="field" wx:if="{{editable.school}}"><text class="field-label">学校</text><input disabled="{{saving || savedPersonId}}" class="field-control" value="{{form.school}}" placeholder="在读或曾就读的学校" maxlength="50" data-field="school" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.industry}}"><text class="field-label">行业</text><input disabled="{{saving || savedPersonId}}" class="field-control" value="{{form.industry}}" placeholder="例如：教育、设计、医疗" maxlength="30" data-field="industry" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.occupation}}"><text class="field-label">职业</text><input disabled="{{saving || savedPersonId}}" class="field-control" value="{{form.occupation}}" placeholder="例如：教师、设计师" maxlength="40" data-field="occupation" bindinput="onInput" /></label>
      <label class="field" wx:if="{{editable.bio}}"><text class="field-label">近况</text><textarea disabled="{{saving || savedPersonId}}" class="field-control textarea" value="{{form.bio}}" placeholder="最近过得怎么样？" maxlength="200" data-field="bio" bindinput="onInput" /></label>
    </view>
  </view>
  <view class="sticky-bottom"><button class="btn" disabled="{{saving || photoChecking}}" bindtap="onSave">{{saving ? '正在保存…' : savedPersonId ? '查看资料' : isNew && createMode !== 'self' ? (circle.type === 'family' ? '添加家人' : '添加同学') : '保存资料'}}</button></view>
  <canvas type="2d" id="photoCanvas" class="photo-canvas"></canvas>
</view>
<view class="page edit-page" wx:else><view class="card empty"><view>{{loading ? '正在读取人物资料…' : '暂时无法编辑：' + loadError}}</view><button class="btn secondary" wx:if="{{!loading}}" bindtap="onRetry">重试</button><button class="btn ghost" bindtap="onHome">返回亲友录</button></view></view>
