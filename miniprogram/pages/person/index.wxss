.profile-hero { display: flex; flex-direction: column; align-items: center; padding: 47rpx 25rpx 43rpx; background: linear-gradient(155deg, #e2f0e6, #f1f7ef); border-radius: 34rpx; margin-bottom: 20rpx; }
.profile-avatar { margin-bottom: 20rpx; background: #b9dcc8; color: #2c6e50; }
.profile-photo-action { color: #1d684e; background: #fff; border: 1rpx solid #c5ddce; border-radius: 999rpx; min-height: 54rpx; line-height: 54rpx; padding: 0 22rpx; font-size: 23rpx; font-weight: 700; margin: -7rpx 0 14rpx; }
.profile-name { font-size: 43rpx; font-weight: 760; }.profile-nickname { color: #718a79; font-size: 24rpx; margin: 8rpx 0; }.profile-hero .pill { margin-top: 17rpx; }.profile-city { color: #4f8065; margin-top: 16rpx; font-size: 24rpx; }
.class-pill { background: #e3e9fa; color: #5367a2; }
.relation-card .eyebrow { margin-bottom: 9rpx; }.relation-card .section-title { margin-bottom: 15rpx; }.relation-path { padding: 21rpx; border-radius: 17rpx; background: #f0f7f0; color: #416b53; font-size: 25rpx; line-height: 1.6; word-break: break-all; }.missing { color: #9a6329; background: #fff4e7; font-size: 23rpx; padding: 14rpx 18rpx; margin-top: 12rpx; border-radius: 13rpx; }
.detail-row { display: flex; gap: 25rpx; padding: 18rpx 0; align-items: baseline; border-top: 1rpx solid #eef2ee; }.detail-label { width: 130rpx; flex-shrink: 0; font-size: 24rpx; color: #84948b; }.detail-value { flex: 1; min-width: 0; font-size: 25rpx; line-height: 1.5; word-break: break-all; }.update-time { color: #9aa99e; font-size: 21rpx; margin-top: 15rpx; }.empty-details { color: #9baa9f; padding: 20rpx 0; font-size: 24rpx; }.text-action { color: #26795b; font-size: 23rpx; font-weight: 700; }
.profile-actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 31rpx; }
.suggestion-form { margin-top: 18rpx; }
.suggestion-intro { line-height: 1.55; margin: 8rpx 0 24rpx; }
.suggestion-preview { border-radius: 14rpx; background: #f1f7f1; color: #2c694b; padding: 18rpx; line-height: 1.6; font-size: 24rpx; margin: 15rpx 0; }
.suggestion-message { min-height: 115rpx; width: 100%; box-sizing: border-box; }
.suggestion-form .btn { margin-top: 12rpx; }
