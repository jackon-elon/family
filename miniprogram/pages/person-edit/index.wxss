.intro { margin: 15rpx 0 31rpx; }.form-card { margin-top: 20rpx; padding-top: 8rpx; }.hint { display: block; color: #5f7068; font-size: 13px; line-height: 1.5; margin: 10rpx 0; }.sticky-bottom { margin-top: 28rpx; }
.photo-card { position: relative; margin-bottom: 20rpx; }.photo-card .section-title { margin-bottom: 18rpx; }.photo-row { align-items: flex-start; }.photo-preview { width: 126rpx; height: 126rpx; }.photo-controls { flex: 1; min-width: 0; }.photo-controls .btn { width: 100%; }.photo-controls .hint { margin: 12rpx 0 0; }.photo-visibility { margin-top: 26rpx; }.photo-visibility .hint { margin-top: 12rpx; }.photo-save { width: 100%; margin-top: 22rpx; }.photo-canvas { position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; }
.location-button { width: 100%; }
.self-create-guide,.similar-warning { margin-bottom: 20rpx; }.self-create-guide .small,.similar-warning .small { margin-top: 10rpx; line-height: 1.5; }.self-create-guide .btn,.similar-warning .btn { margin-top: 20rpx; font-size: 23rpx; }.pending-warning { margin-top: 16rpx; background: #fff3e4; color: #9b6939; border-radius: 12rpx; padding: 14rpx; font-size: 22rpx; }.similar-warning { background: #fff8ec; }
