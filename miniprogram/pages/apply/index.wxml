<view class="page apply-page">
  <view class="title">{{statusOnly ? '我的加入申请' : '邀请你加入'}}</view>
  <view class="card error-card" wx:if="{{error}}"><view class="error-title">暂时无法查看</view><view class="subtitle">{{error}}</view><button class="btn status-action" bindtap="onRetry">重试</button><button class="btn secondary status-action" bindtap="onHome">返回首页</button></view>
  <view class="card status-card" wx:if="{{!error && (previewLoading || (statusOnly && checking && !application))}}">正在读取邀请信息…</view>
  <view class="card invite-preview" wx:if="{{circle && !statusOnly && !error && !previewLoading}}">
    <view class="preview-mark">{{circle.type === 'family' ? '家' : '同'}}</view>
    <view class="preview-name">{{circle.name}}</view>
    <view class="pill {{circle.type === 'family' ? '' : 'class-pill'}}">{{circle.type === 'family' ? '家人录' : '同窗录'}}</view>
    <view class="small muted class-meta" wx:if="{{circle.type === 'classmate'}}">{{circle.school}} · {{circle.cohort}} · {{circle.className}}</view>
    <view class="divider"></view><view class="small muted">有效期至 {{expiryText}}。申请通过前看不到这里的资料。</view>
  </view>
  <view wx:if="{{!error && !previewLoading && canOpenCircle}}" class="card status-card"><view class="success-icon">✓</view><view class="status-title">你已加入{{circle.type === 'family' ? '这个家人录' : '这个同窗录'}}</view><view class="subtitle">直接打开即可，无需再次申请。</view><button class="btn status-action" bindtap="onOpenCircle">打开{{circle.type === 'family' ? '家人录' : '同窗录'}}</button><button class="home-action" bindtap="onHome">返回亲友录</button></view>
  <view wx:elif="{{!error && !previewLoading && inviteStateLoading}}" class="card status-card">正在确认你的加入状态…</view>
  <view wx:elif="{{!error && !previewLoading && inviteStateError}}" class="card status-card"><view class="status-title">暂时无法确认加入状态</view><view class="subtitle">{{inviteStateError}}</view><button class="btn secondary status-action" bindtap="onRetry">重试</button><button class="home-action" bindtap="onHome">返回亲友录</button></view>
  <view wx:elif="{{!error && !previewLoading && status && status !== 'active' && !submitted && !statusOnly}}" class="card status-card"><view class="status-title">{{status === 'expired' ? '邀请已过期' : status === 'revoked' ? '邀请已撤销' : '邀请已使用'}}</view><view class="subtitle">{{loginRequired ? '如果你已申请或已经加入，登录后即可查看；首次加入请联系管理员重新邀请。' : '首次加入请联系管理员重新邀请。'}}</view><button wx:if="{{loginRequired}}" class="btn secondary status-action" bindtap="onLogin">登录查看我的加入状态</button><button class="home-action" bindtap="onHome">返回亲友录</button></view>
  <view wx:elif="{{!error && submitted}}" class="card status-card"><view class="success-icon">{{application && application.status === 'approved' && application.canEnter === true ? '✓' : '·'}}</view><view class="status-title">{{applicationTitle}}</view><view class="subtitle">{{applicationMessage}}</view><view class="small muted status-meta" wx:if="{{application}}">{{application.circleName || (circle && circle.name) || '亲友录'}} · {{applicationDate}}</view><button wx:if="{{application && application.status === 'approved' && application.canEnter === true}}" class="btn status-action" bindtap="onOpenCircle">打开亲友录</button><button wx:else class="btn secondary status-action" loading="{{checking}}" bindtap="loadMyStatus">刷新审核状态</button><button class="home-action" bindtap="onHome">返回首页</button></view>
  <view wx:elif="{{!error && !previewLoading && status === 'active'}}" class="card apply-form">
    <view class="section-title">申请加入</view>
    <view class="small muted form-intro">使用「我的资料」申请，管理员确认后即可加入。</view>
    <view class="small muted profile-loading" wx:if="{{profileLoading}}">正在读取我的资料…</view>
    <view class="error" wx:elif="{{profileError}}">{{profileError}}<button class="btn secondary small-btn" bindtap="loadAccountProfile">重试</button></view>
    <view wx:elif="{{loginRequired}}"><view class="profile-guide">先用微信手机号登录，再查看和申请加入。</view><button class="btn" bindtap="onLogin">微信手机号登录</button></view>
    <view wx:elif="{{!profileReady}}"><view class="profile-guide">请先在「我的资料」填写姓名、所在城市和阳历或农历生日。</view><button class="btn secondary" bindtap="onEditProfile">完善我的资料</button></view>
    <block wx:else>
      <view class="profile-summary"><view class="strong">{{profile.name}}</view><view class="small muted">{{profile.country}} · {{profile.province ? profile.province + ' · ' : ''}}{{profile.city}} · {{profileBirthdayText}}</view><button class="profile-edit" bindtap="onEditProfile">修改我的资料 ›</button></view>
      <label class="field"><text class="field-label">身份说明{{circle.type === 'classmate' ? ' *' : '（建议填写）'}}</text><textarea class="field-control textarea" value="{{note}}" placeholder="{{circle.type === 'classmate' ? '例如：青禾中学 2020 届三班，王宁' : '例如：谁邀请了你，或你认识这里的哪位家人'}}" maxlength="120" bindinput="onInput" /></label>
      <button class="btn" disabled="{{submitting}}" bindtap="onSubmit">{{submitting ? '正在提交…' : '提交加入申请'}}</button>
    </block>
    <view class="small muted privacy-note">申请通过前，这里的成员看不到你的资料。</view>
  </view>
</view>
