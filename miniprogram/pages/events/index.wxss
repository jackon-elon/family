.events-page { padding-top: 25rpx; }
.events-hero { padding: 43rpx 37rpx 48rpx; border-radius: 35rpx; background: #fbe9d9; margin-bottom: 34rpx; }
.events-hero .eyebrow { color: #a77751; }
.events-hero .title { margin: 18rpx 0 14rpx; color: #684d3c; }
.events-hero .subtitle { color: #7e695c; }
.events-heading { margin: 0 4rpx 13rpx; align-items: end; }
.events-heading .section-title { margin: 0; }
.event-list { padding: 5rpx 22rpx; }
.event-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 3rpx; }
.event-row + .event-row { border-top: 1rpx solid #eef2ee; }
.date-badge { width: 94rpx; min-width: 94rpx; text-align: center; line-height: 1.3; color: #a45c39; font-weight: 750; font-size: 23rpx; }
.date-sub { display: block; margin-top: 6rpx; font-size: 19rpx; font-weight: 650; color: #9c7c68; }
.event-row .avatar { width: 70rpx; height: 70rpx; border-radius: 23rpx; background: #f7e4d7; color: #a45c39; font-size: 28rpx; }
.event-row .person-meta { white-space: normal; }
.event-note { padding: 20rpx 8rpx; line-height: 1.6; }
.retry { margin-top: 24rpx; }
