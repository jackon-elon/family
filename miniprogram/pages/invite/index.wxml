<view class="page invite-page" wx:if="{{circle && !loadError && !loading}}">
  <view class="title">邀请{{circle.type === 'family' ? '家人' : '同学'}}加入</view><view class="subtitle intro">{{demoMode ? '先体验邀请和审核流程，演示邀请暂不能发给微信好友。' : '发给微信好友，或让对方扫码。3 天内有效，每份邀请限一人。'}}</view>
  <view class="card review-card"><view class="section-title">加入前由管理员确认</view><view class="small muted">通过后，对方可以查看{{circle.name}}里 {{sharedPeople}} 位{{circle.type === 'family' ? '家人' : '同学'}}的资料、照片和联系方式。</view></view>
  <view wx:if="{{!invite}}" class="create-invite"><button class="btn" disabled="{{creating}}" bindtap="onGenerate">{{creating ? '正在生成…' : demoMode ? '生成演示邀请' : '生成微信 / 扫码邀请'}}</button></view>
  <view wx:else>
    <view class="card invite-card"><view class="row between"><view class="pill">可用邀请</view><text class="small muted">{{expiryText}} 到期</text></view><view class="invite-name">{{circle.name}}</view>
      <view class="qr-panel" wx:if="{{!demoMode && qrPath}}"><image class="invite-qr" src="{{qrPath}}" mode="aspectFit" show-menu-by-longpress="{{true}}"/><view class="qr-caption">让对方用微信扫一扫</view></view>
      <view class="qr-panel" wx:elif="{{!demoMode}}"><view class="qr-caption">{{qrLoading ? '正在生成二维码…' : '二维码暂时不可用'}}</view><view class="small muted">{{qrError || '也可以发给微信好友，或复制邀请口令'}}</view><button wx:if="{{!qrLoading}}" class="btn secondary" disabled="{{creating || loading || !!busyInviteId}}" bindtap="onRetryQr">重新加载二维码</button></view>
      <button class="btn share-btn" wx:if="{{!demoMode}}" disabled="{{creating || loading || !!busyInviteId}}" open-type="share">发给微信好友</button><button class="btn secondary" disabled="{{creating || loading || !!busyInviteId}}" bindtap="onCopy">{{demoMode ? '复制演示口令' : '复制邀请口令'}}</button><button class="btn ghost" disabled="{{creating || loading || !!busyInviteId}}" bindtap="onPreview">查看邀请页面</button>
    </view>
    <button class="revoke" disabled="{{creating || loading || !!busyInviteId}}" bindtap="onRevoke">撤销这份邀请</button>
  </view>
  <view class="card review-card" wx:if="{{olderInvites.length}}"><view class="section-title">之前的邀请</view><view class="small muted">还在有效期内，可以随时撤销。</view>
    <view class="row between" wx:for="{{olderInvites}}" wx:key="id"><view class="small muted">{{item.expiryText}} 到期</view><button class="btn ghost" size="mini" data-id="{{item.id}}" disabled="{{!!busyInviteId}}" bindtap="onRevokeListed">{{busyInviteId === item.id ? '撤销中…' : '撤销'}}</button></view>
  </view>
</view>
<view class="page invite-page" wx:elif="{{loading}}"><view class="card review-card">正在读取邀请…</view></view>
<view class="page invite-page" wx:else><view class="card review-card"><view class="section-title">暂时无法查看邀请</view><view class="small muted">{{loadError || '请稍后重试'}}</view><button class="btn" bindtap="onRetry">重试</button><button class="btn secondary" bindtap="onHome">返回首页</button></view></view>
