.circle-page { padding-top: 20rpx; }
.self-prompt { display: flex; align-items: center; gap: 12rpx; padding: 20rpx; margin: 20rpx 0 0; border-radius: 19rpx; background: #fff7e8; }.self-prompt .btn { flex-shrink: 0; }.self-prompt .small { margin-top: 5rpx; line-height: 1.4; }
.claim-guide { margin-top: 19rpx; padding: 27rpx; }.claim-guide .section-title { margin: 8rpx 0 0; }.claim-intro { margin-top: 11rpx; line-height: 1.55; }.claim-subheading { font-weight: 700; color: #315b43; margin: 24rpx 0 11rpx; font-size: 25rpx; }.claim-search { padding: 12rpx 18rpx; background: #f3f7f3; border-radius: 14rpx; }.claim-search input { font-size: 24rpx; }.claim-person { display: flex; align-items: center; gap: 12rpx; border-bottom: 1rpx solid #eef1ee; padding: 17rpx 0; }.claim-person:last-child { border-bottom: 0; }.claim-person .avatar { flex-shrink: 0; }.claim-person-name { font-size: 25rpx; font-weight: 700; }.claim-person .small { margin-top: 4rpx; }.claim-person-btn { flex-shrink: 0; font-size: 21rpx; padding: 0 17rpx; }.claim-show-all { padding: 17rpx 0 3rpx; color: #277454; font-size: 24rpx; font-weight: 690; }.claim-create { margin-top: 23rpx; padding-top: 20rpx; border-top: 1rpx solid #e8eee8; }.claim-create .btn { margin-top: 16rpx; font-size: 24rpx; }.claim-pending { background: #e9f4ec; border-radius: 15rpx; padding: 20rpx; margin-top: 19rpx; }.claim-pending .small { margin-top: 6rpx; line-height: 1.5; }.claim-rejected { background: #fff5e9; color: #996f3e; padding: 14rpx; border-radius: 13rpx; margin-top: 18rpx; }
.circle-head { border-radius: 34rpx; background: #e4eee4; padding: 36rpx; position: relative; overflow: hidden; }
.circle-head::after { content: ''; position: absolute; width: 230rpx; height: 230rpx; border-radius: 50%; background: #d4e6d7; right: -70rpx; bottom: -115rpx; }
.circle-head .title { font-size: 43rpx; margin: 20rpx 0 9rpx; position: relative; z-index: 1; }
.circle-head .subtitle,.head-footer { position: relative; z-index: 1; }
.class-pill { background: #e6e9fa; color: #5b68a2; }
.head-footer { margin-top: 30rpx; color: #658171; font-size: 23rpx; }
.main-tabs { margin: 25rpx 0; }
.search-box { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 0 22rpx; height: 82rpx; margin-bottom: 22rpx; }
.search-box input { flex: 1; font-size: 25rpx; }
.search-icon { font-size: 45rpx; color: #a1b1a5; margin-right: 13rpx; line-height: 1; }
.text-action { color: #25805d; font-size: 24rpx; font-weight: 700; }
.network-heading { margin: 28rpx 3rpx 16rpx; }
.network-heading .section-title { margin-bottom: 7rpx; }
.network-tip { margin: 17rpx 6rpx; line-height: 1.5; }
.star-person-card { position: fixed; z-index: 100; left: 24rpx; right: 24rpx; box-sizing: border-box; max-height: 40vh; overflow-y: auto; padding: 20rpx 24rpx 14rpx; border: 1rpx solid #d9e1d4; border-radius: 24rpx; background: #fffefa; box-shadow: 0 10rpx 32rpx rgba(42, 59, 38, .15); }
.star-card-bottom { bottom: calc(18rpx + env(safe-area-inset-bottom)); }
.star-card-top { top: 16rpx; }
.star-person-card .row.between { gap: 12rpx; align-items: flex-start; }
.star-person-heading { flex: 1; min-width: 0; }
.star-person-heading .avatar { width: 66rpx; height: 66rpx; flex-shrink: 0; }
.star-person-title { flex: 1; min-width: 0; }
.star-person-title .section-title { margin: 2rpx 0 0; font-size: 31rpx; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.star-original { margin-top: 3rpx; color: #84917c; font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.star-close { flex-shrink: 0; width: 80rpx; min-height: 80rpx; line-height: 70rpx; text-align: center; font-size: 42rpx; color: #73836e; }
.star-person-card .star-close { margin: -12rpx -15rpx -8rpx 0; }
.star-term { margin-top: 10rpx; color: #365d43; font-size: 27rpx; font-weight: 600; }
.star-relation { margin: 8rpx 0 0; color: #74846b; font-size: 23rpx; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.star-missing { margin-top: 5rpx; color: #8a8d7a; font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.star-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 8rpx; }
.star-card-footer .small { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.star-open { flex-shrink: 0; margin: 0; padding: 0 12rpx; min-height: 68rpx; line-height: 68rpx; font-size: 25rpx; font-weight: 600; color: #3c7150; background: transparent; border: 0; border-radius: 10rpx; }
.star-open::after { border: 0; }
.remark-notice { display: flex; align-items: center; gap: 18rpx; color: #8c795f; font-size: 23rpx; margin: -8rpx 4rpx 12rpx; }
.remark-retry { padding: 14rpx 6rpx; color: #3c7150; }
.person-row .grow { min-width: 0; }
.person-name-row { min-width: 0; }
.person-name-row .pill { flex-shrink: 0; }
.person-row .person-name,.city-row .person-name { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.original-name { margin-top: 4rpx; color: #84917c; font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.list-heading { margin: 30rpx 3rpx 11rpx; align-items: baseline; }.list-heading .section-title { margin: 0; }
.filter-row { display: flex; gap: 12rpx; overflow-x: auto; white-space: nowrap; margin-bottom: 25rpx; }
.filter-chip { border-radius: 999rpx; background: #eaf1eb; color: #557064; font-size: 22rpx; padding: 13rpx 18rpx; }
.list-card { padding: 12rpx 26rpx; }
.map-heading { margin: 33rpx 2rpx 21rpx; align-items: end; }.map-heading .section-title { margin-bottom: 2rpx; }
.map-toggle { display: flex; border-radius: 15rpx; background: #e8efea; padding: 4rpx; }.map-toggle text { color: #71857a; padding: 11rpx 18rpx; font-size: 22rpx; border-radius: 12rpx; }.map-toggle .active { background: #fff; color: #2d7456; font-weight: 700; }
.map-note { color: #5b806c; background: #e8f2e7; border-radius: 15rpx; padding: 16rpx 18rpx; margin-top: 15rpx; font-size: 23rpx; }
.city-sheet { position: fixed; z-index: 30; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); max-height: 62vh; overflow-y: auto; box-shadow: 0 15rpx 45rpx rgba(10, 32, 22, 0.22); }.city-sheet .section-title { margin: 0; }
.city-heading { margin-top: 30rpx; }.city-row { display: flex; align-items: center; gap: 13rpx; padding: 19rpx 0; border-bottom: 1rpx solid #eef2ee; font-weight: 660; }.city-row:last-child { border-bottom: 0; }.city-pin { color: #3b916a; }
.leave-entry { margin: 42rpx 0 8rpx; }.leave-entry .btn { width: 100%; color: #7e544b; }
