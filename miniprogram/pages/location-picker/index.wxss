.picker-page { padding-bottom: 36rpx; }
.intro { margin: 16rpx 0 24rpx; }
.name-card { padding-top: 9rpx; padding-bottom: 9rpx; }
.region-row { display: flex; gap: 12rpx; margin: 24rpx 0 14rpx; overflow-x: auto; white-space: nowrap; }
.region-chip { flex-shrink: 0; border-radius: 999rpx; padding: 12rpx 22rpx; background: #e5f1e9; color: #236c51; font-size: 24rpx; font-weight: 700; }
.map-frame { position: relative; overflow: hidden; width: 100%; height: 670rpx; border-radius: 26rpx; background: #dce9de; }
.picker-map { width: 100%; height: 100%; }
.crosshair { position: absolute; left: 50%; top: 50%; width: 60rpx; height: 60rpx; margin-left: -30rpx; margin-top: -46rpx; text-align: center; line-height: 60rpx; font-size: 57rpx; font-weight: 700; color: #c44c3e; text-shadow: 0 2rpx 6rpx #fff; pointer-events: none; }
.map-caption { margin: 13rpx 0 18rpx; text-align: center; color: #526e60; font-size: 23rpx; }
.privacy-note { padding: 20rpx 23rpx; line-height: 1.5; color: #597568; font-size: 23rpx; }
