<view class="page circles-page">
  <view class="hero">
    <view class="eyebrow">好久不见，也能随时找到</view>
    <view class="title">人间星图</view>
    <view class="subtitle">把牵挂的人，放在心上与地图上。</view>
    <view class="hero-ornament ornament-one"></view><view class="hero-ornament ornament-two"></view>
  </view>

  <view class="mode-banner" wx:if="{{demoMode}}">
    <text class="mode-dot"></text><text class="grow">本地演示 · 所有资料只保存在此设备</text>
  </view>
  <view class="mode-banner" wx:else>
    <text class="mode-dot cloud"></text><text class="grow">云端模式</text>
  </view>

  <view class="card empty compact" wx:if="{{loading}}">正在读取亲友录和申请…</view>
  <view class="card empty compact" wx:elif="{{loadError}}"><view>暂时无法读取亲友录：{{loadError}}</view><button class="btn secondary" bindtap="onRetryApplications">重试</button></view>
  <block wx:else>

  <view class="application-section" wx:if="{{applicationRows.length}}">
    <view class="row between group-heading"><view><view class="section-title">我的加入申请</view></view><text class="group-count">最近 {{allApplicationRows.length}} 条</text></view>
    <view class="application-card" wx:for="{{applicationRows}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenApplication">
      <view class="grow"><view class="application-name">{{item.circleName || (item.circleType === 'classmate' ? '同窗录申请' : '受邀加入的记录')}}</view><view class="application-date">{{item.date}} 提交 · 点开查看</view></view><text class="pill {{item.status === 'approved' ? '' : 'grey'}}">{{item.statusText}}</text><text class="chevron">›</text>
    </view>
  </view>
  <view class="application-error" wx:if="{{allApplicationRows.length > 5}}" bindtap="onToggleApplications">{{showAllApplications ? '收起申请' : '展开最近 ' + allApplicationRows.length + ' 条申请'}}</view>
  <view class="small muted" wx:if="{{hasMoreApplications}}">这里只显示最近 20 条申请。更早的记录暂不在此列表；如需核对，请联系管理员。</view>
  <view class="application-error" wx:if="{{applicationError}}" bindtap="onRetryApplications">{{applicationError}}</view>

  <view class="row between group-heading"><view><view class="section-title">家人录</view></view><text class="group-count">{{familyCircles.length}} 份</text></view>
  <view wx:if="{{familyCircles.length}}">
    <view class="circle-card family" wx:for="{{familyCircles}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenCircle">
      <view class="circle-mark">家</view><view class="grow"><view class="circle-name">{{item.name}}</view><view class="circle-meta">{{item.personCount}} 人</view></view><text class="chevron">›</text>
    </view>
  </view>
  <view class="card empty compact" wx:else>还没有家人录，可以先为家人建一份。</view>

  <view class="row between group-heading"><view><view class="section-title">同窗录</view></view><text class="group-count">{{classCircles.length}} 份</text></view>
  <view wx:if="{{classCircles.length}}">
    <view class="circle-card class" wx:for="{{classCircles}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenCircle">
      <view class="circle-mark">同</view><view class="grow"><view class="circle-name">{{item.name}}</view><view class="circle-meta">{{item.personCount}} 人 · {{item.school || '同班同学'}}</view></view><text class="chevron">›</text>
    </view>
  </view>
  <view class="card empty compact" wx:else>还没有同窗录。每个班级可以单独建一份。</view>

  <view class="row between group-heading birthday-heading"><view><view class="section-title">近期生日</view></view><text class="birthday-link" bindtap="onOpenEvents">查看日程 ›</text></view>
  <view class="birthday-card" wx:if="{{birthdayPreview.length}}">
    <view class="birthday-row" wx:for="{{birthdayPreview}}" wx:key="personId" data-person-id="{{item.personId}}" data-circle-id="{{item.circleId}}" bindtap="onOpenBirthday">
      <view class="birthday-date"><text>{{item.dateLabel}}</text><text class="birthday-countdown">{{item.countdownLabel}}</text></view>
      <view class="grow"><view class="birthday-name">{{item.personName}}</view><view class="birthday-meta">{{item.circleName}} · {{item.sourceLabel}}</view></view><text class="chevron">›</text>
    </view>
  </view>
  <view class="card empty compact birthday-empty" wx:elif="{{birthdayError}}" bindtap="onRetryBirthdays">{{birthdayError}}</view>
  <view class="card empty compact birthday-empty" wx:else bindtap="onOpenEvents">未来 30 天暂无生日，查看全年日程 ›</view>

  <button class="btn create-button" bindtap="onCreate">＋ 新建家人录或同窗录</button>

  </block>
</view>
