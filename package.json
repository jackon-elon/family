{
  "name": "family-class-network-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "亲友关系网微信小程序本地开发与测试",
  "scripts": {
    "sync:kinship": "node scripts/sync-kinship.mjs",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:cloud": "npm run build:backend && node backend/scripts/package-cloud-function.cjs && npm run check:cloud",
    "check:cloud": "node scripts/check-cloud-package.mjs",
    "test:backend": "npm run build:cloud && node --test backend/tests/*.test.cjs",
    "test:kinship": "node --experimental-strip-types --test packages/kinship/test/*.test.mjs",
    "test:star": "node --experimental-strip-types --test miniprogram/components/star-network/layout.test.mjs",
    "test:frontend": "node --test miniprogram/tests/*.test.cjs",
    "typecheck:kinship": "tsc --noEmit --strict --target ES2022 --module CommonJS --skipLibCheck packages/kinship/src/index.ts",
    "typecheck:frontend": "npm run sync:kinship && tsc -p miniprogram/tsconfig.json --noEmit",
    "check:project": "node scripts/check-project.mjs",
    "test": "npm run typecheck:kinship && npm run test:kinship && npm run test:star && npm run test:backend && npm run typecheck:frontend && npm run test:frontend && npm run check:project"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
