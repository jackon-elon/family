.cosmos-wrap { overflow: hidden; border: 1rpx solid #e5e4dc; border-radius: 26rpx; color: #354941; background: #f8f6f0; }
.cosmos-header { height: 72rpx; padding: 0 26rpx; display: flex; align-items: center; justify-content: space-between; background: #fbfaf6; border-bottom: 1rpx solid #e9e7df; }
.cosmos-heading { display: flex; align-items: center; gap: 13rpx; }
.cosmos-kicker { color: #52675c; font-size: 24rpx; font-weight: 600; }
.cosmos-heading-rule { width: 28rpx; height: 1rpx; background: #c2cfc3; }
.cosmos-counter { color: #7b867d; font-size: 23rpx; }
.cosmos-viewport { position: relative; width: 100%; overflow: hidden; }
.cosmos-board { position: absolute; overflow: hidden; background: #f8f6f0; }
.generation-band { position: absolute; box-sizing: border-box; border-top: 1rpx solid #e6e5dc; pointer-events: none; }
.generation-band.is-my-generation { background: #f0f3eb; border-top-color: #dce5d8; }
.generation-band.is-unlinked-generation { background: #f5f3ef; border-top-style: dashed; }
.generation-heading { position: absolute; display: flex; align-items: center; gap: 9rpx; height: 34rpx; white-space: nowrap; }
.generation-dash { width: 12rpx; height: 2rpx; background: #a7b8a9; }
.generation-name { color: #758274; font-size: 24rpx; line-height: 34rpx; font-weight: 500; }
.generation-name.is-current-label { color: #466c55; }
.relation-line { position: absolute; z-index: 1; height: 2rpx; transform-origin: left center; background: #a7b9aa; pointer-events: none; }
.relation-spouse { background: #c4aca5; }
.relation-sibling { background: #b6bcae; }
.person-node { position: absolute; z-index: 2; box-sizing: border-box; width: 154rpx; height: 174rpx; padding: 12rpx 8rpx 10rpx; display: flex; flex-direction: column; align-items: center; transform: translate(-50%, -50%); border: 1rpx solid #dfE5db; border-radius: 19rpx; background: #fffefa; box-shadow: 0 4rpx 10rpx rgba(70, 83, 61, .04); text-align: center; }
.person-node.is-focus { border-color: #91ad98; }
.person-node.is-self { border: 3rpx solid #638970; padding-top: 10rpx; background: #eef4e9; }
.person-node.is-unlinked { border-style: dashed; }
.person-node.is-conflicted { border-color: #b9a581; border-style: dashed; }
.person-node.is-dimmed { opacity: .55; }
.person-node.is-selected { z-index: 3; opacity: 1; border: 3rpx solid #3f7056; padding-top: 10rpx; background: #e9f1e6; box-shadow: 0 5rpx 14rpx rgba(51, 83, 61, .10); }
.portrait-frame { box-sizing: border-box; flex-shrink: 0; width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; color: #607462; background: #e6ecdf; font-size: 27rpx; font-weight: 500; }
.portrait-frame image { display: block; width: 100%; height: 100%; border-radius: 50%; }
.tone-1 .portrait-frame { color: #74758a; background: #ebe9ef; }
.tone-2 .portrait-frame { color: #5d7c75; background: #e1ece5; }
.tone-3 .portrait-frame { color: #937463; background: #f0e8de; }
.is-self .portrait-frame { color: #fff; background: #668d73; }
.person-name { box-sizing: border-box; flex-shrink: 0; display: block; width: 100%; min-width: 0; height: 34rpx; margin-top: 9rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #344b3d; font-size: 27rpx; line-height: 34rpx; font-weight: 600; }
.person-relation { box-sizing: border-box; flex-shrink: 0; display: block; width: 100%; min-width: 0; height: 30rpx; margin-top: 3rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #7b8778; font-size: 22rpx; line-height: 30rpx; }
.is-self .person-relation { color: #4d775b; }
.cosmos-footer { min-height: 58rpx; padding: 9rpx 18rpx 11rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3rpx; color: #7b8879; font-size: 21rpx; background: #fbfaf6; border-top: 1rpx solid #e9e7df; }
.cosmos-empty { height: 370rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #526a56; font-size: 26rpx; }
.empty-star { width: 14rpx; height: 14rpx; margin-bottom: 26rpx; border-radius: 50%; background: #a2b79d; }
.empty-sub { color: #83917f; font-size: 23rpx; margin-top: 11rpx; }
