<view class="page profile-page" wx:if="{{!loading && !loadError}}">
  <view class="eyebrow">我的资料</view>
  <view class="title">一份资料，处处相见</view>
  <view class="subtitle intro">姓名、照片、城市和生日只在这里维护一次；你加入的家人录、同窗录会同步显示。关系和辈分仍按各份记录整理。</view>
  <view class="card photo-card">
    <view class="section-title">我的照片</view>
    <view class="row gap photo-row"><view class="avatar large"><image wx:if="{{form.photoUrl}}" src="{{form.photoUrl}}" mode="aspectFill"/><text wx:else>{{initial}}</text></view><view class="photo-controls"><button class="btn secondary small-btn" disabled="{{photoChecking || saving}}" bindtap="onChoosePhoto">{{photoChecking ? '正在处理照片…' : form.photoUrl || hasPhoto ? '更换照片' : '从相册或相机选择'}}</button><text class="hint">照片会压缩并去除拍摄位置信息。</text></view></view>
  </view>
  <view class="card form-card">
    <label class="field"><text class="field-label">姓名 *</text><input disabled="{{saving}}" class="field-control" value="{{form.name}}" placeholder="请输入姓名" maxlength="30" data-field="name" bindinput="onInput" /></label>
    <label class="field"><text class="field-label">昵称</text><input disabled="{{saving}}" class="field-control" value="{{form.nickname}}" placeholder="熟悉的人怎么叫你" maxlength="30" data-field="nickname" bindinput="onInput" /></label>
    <label class="field"><text class="field-label">性别（用于计算亲属称呼）</text><picker disabled="{{saving}}" mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGender"><view class="field-control {{genderIndex ? '' : 'placeholder'}}">{{genderOptions[genderIndex]}} ▾</view></picker></label>
    <view class="field"><text class="field-label">所在城市 *</text><button class="btn secondary location-button" disabled="{{saving}}" bindtap="onChooseCityPoint">{{form.city ? (form.country + ' · ' + (form.province ? form.province + ' · ' : '') + form.city) : '逐级选择城市'}}</button><text class="hint">只记录城市，不读取你的实时位置或住址。</text></view>
    <view class="field"><text class="field-label">生日 *</text><view class="row gap birthday-pickers"><picker disabled="{{saving}}" mode="selector" range="{{calendarOptions}}" value="{{calendarIndex}}" bindchange="onCalendar"><view class="field-control">{{calendarOptions[calendarIndex]}} ▾</view></picker><picker disabled="{{saving}}" mode="selector" range="{{monthOptions}}" value="{{monthIndex}}" bindchange="onBirthMonth"><view class="field-control">{{monthIndex >= 0 ? monthOptions[monthIndex] : '选月份'}} ▾</view></picker><picker disabled="{{saving}}" mode="selector" range="{{dayOptions}}" value="{{dayIndex}}" bindchange="onBirthDay"><view class="field-control">{{dayIndex >= 0 ? dayOptions[dayIndex] : '选日期'}} ▾</view></picker></view><label class="leap-row" wx:if="{{calendarIndex === 1}}"><switch disabled="{{saving}}" checked="{{leapMonth}}" bindchange="onLeapMonth" color="#258660" />农历闰月</label><input disabled="{{saving}}" class="field-control birth-year" value="{{form.birthYear}}" type="number" placeholder="出生年份（选填，可自动判断长幼）" maxlength="4" data-field="birthYear" bindinput="onInput" /><text class="hint">每年自动换算下一次公历日期；农历生日也会出现在生日提醒中。</text><text class="birthday-next" wx:if="{{nextBirthday}}">{{nextBirthday}}</text></view>
    <label class="field"><text class="field-label">目前状态</text><picker disabled="{{saving}}" mode="selector" range="{{statusOptions}}" value="{{statusIndex}}" bindchange="onStatus"><view class="field-control {{statusIndex ? '' : 'placeholder'}}">{{statusOptions[statusIndex]}} ▾</view></picker></label>
    <label class="field"><text class="field-label">学校</text><input disabled="{{saving}}" class="field-control" value="{{form.school}}" placeholder="在读或曾就读的学校" maxlength="50" data-field="school" bindinput="onInput" /></label>
    <label class="field"><text class="field-label">行业</text><input disabled="{{saving}}" class="field-control" value="{{form.industry}}" placeholder="例如：教育、设计、医疗" maxlength="30" data-field="industry" bindinput="onInput" /></label>
    <label class="field"><text class="field-label">职业</text><input disabled="{{saving}}" class="field-control" value="{{form.occupation}}" placeholder="例如：教师、设计师" maxlength="40" data-field="occupation" bindinput="onInput" /></label>
    <label class="field"><text class="field-label">近况</text><textarea disabled="{{saving}}" class="field-control textarea" value="{{form.bio}}" placeholder="最近过得怎么样？" maxlength="200" data-field="bio" bindinput="onInput" /></label>
    <label class="field"><text class="field-label">联系手机号（选填）</text><input disabled="{{saving}}" class="field-control" value="{{form.phone}}" type="text" placeholder="愿意让同录成员联系你时再填写" maxlength="20" data-field="phone" bindinput="onInput" /></label>
    <label class="field"><text class="field-label">微信号（选填）</text><input disabled="{{saving}}" class="field-control" value="{{form.wechatId}}" placeholder="填写微信号" maxlength="40" data-field="wechatId" bindinput="onInput" /></label>
  </view>
  <view class="sticky-bottom"><button class="btn" disabled="{{saving || photoChecking}}" bindtap="onSave">{{saving ? '正在保存…' : createSelf ? '保存并继续' : '保存我的资料'}}</button></view>
  <canvas type="2d" id="photoCanvas" class="photo-canvas"></canvas>
</view>
<view class="page profile-page" wx:else><view class="card empty"><view>{{loading ? '正在读取我的资料…' : '暂时无法打开资料：' + loadError}}</view><button class="btn secondary" wx:if="{{!loading}}" bindtap="onRetry">重试</button><button class="btn ghost" bindtap="onHome">返回亲友录</button></view></view>
