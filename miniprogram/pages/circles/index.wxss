.circles-page { padding-top: 24rpx; }
.hero { position: relative; overflow: hidden; border-radius: 38rpx; padding: 55rpx 38rpx 65rpx; background: #dfeee4; margin-bottom: 24rpx; }
.hero .eyebrow { position: relative; z-index: 1; color: #538674; }
.hero .title { position: relative; z-index: 1; margin: 19rpx 0 20rpx; color: #1e5542; }
.hero .subtitle { position: relative; z-index: 1; max-width: 500rpx; color: #4d7465; }
.hero-ornament { position: absolute; border-radius: 50%; background: #c4e1ce; }
.ornament-one { width: 280rpx; height: 280rpx; right: -105rpx; top: -70rpx; }
.ornament-two { width: 170rpx; height: 170rpx; right: 25rpx; bottom: -98rpx; background: #add8be; }
.mode-banner { display: flex; align-items: center; gap: 12rpx; margin: 10rpx 0 42rpx; font-size: 22rpx; color: #687c72; }
.mode-dot { width: 13rpx; height: 13rpx; border-radius: 50%; background: #6faf7a; }
.mode-dot.cloud { background: #49a8d2; }
.mode-link { color: #2d7859; font-weight: 650; }
.group-heading { margin: 31rpx 3rpx 14rpx; align-items: end; }
.group-heading .section-title { margin: 7rpx 0 0; }
.group-count { font-size: 23rpx; color: #91a097; padding-bottom: 5rpx; }
.circle-card { display: flex; align-items: center; gap: 22rpx; padding: 24rpx; background: #fff; border-radius: 28rpx; margin: 13rpx 0; box-shadow: 0 10rpx 27rpx rgba(14, 49, 34, .04); }
.circle-mark { width: 90rpx; height: 90rpx; display: flex; align-items: center; justify-content: center; border-radius: 26rpx; font-weight: 750; font-size: 36rpx; background: #e0f0e5; color: #337857; }
.class .circle-mark { color: #5366a6; background: #e6ebfb; }
.circle-name { font-weight: 730; font-size: 30rpx; }
.circle-meta { font-size: 23rpx; color: #84948b; margin-top: 8rpx; }
.empty.compact { padding: 36rpx; font-size: 24rpx; text-align: left; }
.sticky-bottom { margin-top: 35rpx; }
.demo-footer { text-align: center; margin-top: 20rpx; font-size: 21rpx; color: #9aaa9f; }
