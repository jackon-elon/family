<view class="page manage-page" wx:if="{{circle && !loading && !loadError}}">
  <view class="eyebrow">CIRCLE ADMIN</view><view class="title">管理 {{circle.name}}</view><view class="subtitle intro">邀请熟人、核对申请，帮圈子里的关系保持清楚。</view>
  <view class="action-tile" bindtap="onInvite"><view class="tile-icon">邀</view><view class="grow"><view class="strong">邀请真人加入圈子</view><view class="small muted">分享一次性邀请；通过审核后才有访问权</view></view><text class="chevron">›</text></view>
  <view class="action-tile placeholder-tile" bindtap="onAddPerson"><view class="tile-icon">人</view><view class="grow"><view class="strong">添加未加入的人物卡</view><view class="small muted">先记录家人或同学；不会给对方访问权</view></view><text class="chevron">›</text></view>

  <view class="section-title block-title">加入申请 <text class="count">{{applications.length}}</text></view>
  <view class="card" wx:if="{{applications.length}}"><view class="review-row" wx:for="{{applications}}" wx:key="id"><view class="row between"><view class="person-name">{{item.applicantName || item.name}}</view><text class="small muted">{{item.createdText}}</text></view><view class="review-note">{{item.note || '未填写身份说明'}}</view><view class="invite-expiry {{item.inviteUnavailable || item.inviteExpiringSoon ? 'warning' : ''}}" wx:if="{{item.inviteStatusText}}">{{item.inviteStatusText}}</view><view class="review-actions"><button class="btn secondary small-btn" data-id="{{item.id}}" data-decision="reject" bindtap="onJoin">拒绝</button><button class="btn small-btn" disabled="{{item.inviteUnavailable}}" data-id="{{item.id}}" data-decision="approve" bindtap="onJoin">确认加入</button></view></view></view>
  <view class="card empty compact" wx:else>暂时没有待审核的加入申请。</view>

  <view class="section-title block-title" wx:if="{{claimRequests.length}}">认领申请 <text class="count">{{claimRequests.length}}</text></view>
  <view class="card" wx:if="{{claimRequests.length}}"><view class="review-row" wx:for="{{claimRequests}}" wx:key="id"><view class="person-name">{{item.applicantName}} <text class="small muted">申请认领 {{item.targetName}}</text></view><view class="review-note">请核对本人身份和人物卡原有关系。批准后，这张卡会绑定该成员。</view><view class="review-actions"><button class="btn secondary small-btn" data-id="{{item.id}}" data-decision="reject" bindtap="onClaim">拒绝</button><button class="btn small-btn" data-id="{{item.id}}" data-decision="approve" bindtap="onClaim">确认认领</button></view></view></view>

  <view class="section-title block-title" wx:if="{{suggestions.length}}">更正建议 <text class="count">{{suggestions.length}}</text></view>
  <view class="card" wx:if="{{suggestions.length}}"><view class="review-row" wx:for="{{suggestions}}" wx:key="id"><view class="pill grey">{{item.type === 'relation' ? '关系建议' : item.type === 'invite' ? '邀请推荐' : '资料建议'}}</view><view class="review-note">{{item.message}}</view><view class="suggestion-change" wx:if="{{item.structuredRelation}}"><view wx:if="{{item.beforeText}}">原关系：{{item.beforeText}}</view><view wx:if="{{item.afterText}}">建议改为：{{item.afterText}}</view><view wx:else>建议删除这条关系</view></view><view class="review-actions"><button class="btn secondary small-btn" data-id="{{item.id}}" data-status="rejected" bindtap="onSuggestion">拒绝</button><button class="btn small-btn" wx:if="{{item.structuredRelation}}" data-id="{{item.id}}" data-status="accepted" bindtap="onSuggestion">预览并采纳</button><button class="btn small-btn" wx:else data-id="{{item.id}}" bindtap="onSuggestionTarget">去核实更正</button></view></view></view>

  <view class="row between block-title"><view class="section-title">未认领的人物卡</view><text class="text-action" bindtap="onAddPerson">＋ 添加</text></view>
  <view class="small muted section-help">这些是关系网中的人物，不代表 TA 已加入。认领后由本人管理私人资料。</view>
  <view class="card" wx:if="{{unclaimedPeople.length}}"><view class="member-row" wx:for="{{unclaimedPeople}}" wx:key="id"><view class="avatar">{{item.initial}}</view><view class="grow"><view class="person-name">{{item.name}}</view><view class="person-meta">未认领 · 无账号访问权</view></view><text class="text-action" data-id="{{item.id}}" bindtap="onPerson">查看 ›</text></view></view>
  <view class="card empty compact" wx:else>暂无未认领人物卡。</view>

  <view class="section-title block-title">已加入的成员</view>
  <view class="small muted section-help">移出成员会撤销访问权；人物节点和关系保留。错误认领可在「管理」中解绑。</view>
  <view class="card"><view class="member-row" wx:for="{{members}}" wx:key="id"><view class="avatar">{{item.initial}}</view><view class="grow"><view class="person-name">{{item.name}}</view><view class="person-meta">{{item.role === 'owner' ? '圈主' : item.role === 'admin' ? '管理员' : '成员'}} · {{item.personId ? '已认领人物卡' : '尚未认领'}}</view></view><text class="text-action" wx:if="{{item.canManage}}" data-id="{{item.id}}" bindtap="onMemberMenu">管理 ›</text></view></view>

  <view wx:if="{{circle.type === 'family'}}">
    <view class="section-title block-title">整理家庭关系</view>
    <view class="card relation-form" id="relation-editor">
      <view class="strong form-caption">{{editingRelationId ? '修改已记录的关系' : '添加一条关系'}}</view>
      <view class="small muted form-caption">只记录两人之间的事实，称呼由系统按每位成员的本人卡计算。</view>
      <view class="field"><text class="field-label">关系类型</text><picker mode="selector" range="{{relationTypes}}" value="{{relationIndex}}" data-field="relationIndex" bindchange="onPick"><view class="field-control">{{relationTypes[relationIndex]}} ▾</view></picker></view>
      <view class="field"><text class="field-label">{{relationIndex === 0 ? '谁是父母' : '第一位人物'}}</text><picker mode="selector" range="{{personNames}}" value="{{fromIndex}}" data-field="fromIndex" bindchange="onPick"><view class="field-control">{{personNames[fromIndex] || '先添加人物'}} ▾</view></picker></view>
      <view class="field"><text class="field-label">{{relationIndex === 0 ? '谁是子女' : '第二位人物'}}</text><picker mode="selector" range="{{personNames}}" value="{{toIndex}}" data-field="toIndex" bindchange="onPick"><view class="field-control">{{personNames[toIndex] || '先添加人物'}} ▾</view></picker></view>
      <view class="field" wx:if="{{relationIndex === 2}}"><text class="field-label">谁较年长</text><picker mode="selector" range="{{olderOptions}}" value="{{olderIndex}}" data-field="olderIndex" bindchange="onPick"><view class="field-control">{{olderOptions[olderIndex]}} ▾</view></picker></view>
      <view class="relation-preview" wx:if="{{relationPreview}}"><view class="small muted">保存前请核对</view><view class="strong">{{relationPreview}}</view><view class="small muted">{{relationImpact}}</view></view>
      <button class="btn secondary" disabled="{{busy || !canCreateRelation}}" bindtap="onAddRelation">{{editingRelationId ? '预览并保存修改' : '预览并添加关系'}}</button>
      <text class="text-action cancel-edit" wx:if="{{editingRelationId}}" bindtap="onCancelEdit">取消修改</text>
    </view>
    <view class="card relation-list" wx:if="{{relationRows.length}}"><view class="relation-row" wx:for="{{relationRows}}" wx:key="id"><view class="grow"><view class="strong">{{item.text}}</view></view><text class="text-action" data-id="{{item.id}}" bindtap="onEditRelation">修改</text><text class="text-action danger-text" data-id="{{item.id}}" bindtap="onDeleteRelation">删除</text></view></view>
  </view>
  <view class="section-title block-title">操作记录</view>
  <view class="card audit-card" wx:if="{{auditRows.length}}"><view class="audit-row" wx:for="{{auditRows}}" wx:key="id"><view class="audit-dot"></view><view class="grow"><view class="strong">{{item.title}}</view><view class="small muted" wx:if="{{item.detail}}">{{item.detail}}</view></view><text class="audit-time">{{item.when}}</text></view></view>
  <view class="card empty compact" wx:else>还没有操作记录。</view>
  <view class="audit-more" wx:if="{{auditEvents.length > 6}}" bindtap="onMoreAudit">{{showAllAudit ? '收起记录' : '查看全部 ' + auditEvents.length + ' 条记录'}}</view>
</view>
<view class="page manage-page" wx:else><view class="card empty"><view>{{loading ? '正在读取管理资料…' : '暂时无法打开管理页：' + loadError}}</view><button class="btn secondary" wx:if="{{!loading}}" bindtap="onRetry">重试</button><button class="btn ghost" bindtap="onHome">返回我的圈子</button></view></view>
