<view class="page profile-page" wx:if="{{person && !loadError && !loading}}">
  <view class="profile-hero">
    <view class="avatar large profile-avatar"><image wx:if="{{person.photoUrl}}" src="{{person.photoUrl}}" mode="aspectFill"/><text wx:else>{{initial}}</text></view>
    <button class="profile-photo-action" wx:if="{{person.isSelf}}" bindtap="onPhoto">{{person.hasPhoto ? '更换我的照片' : '上传我的照片'}}</button>
    <view class="profile-name">{{displayName || person.name}}</view>
    <view class="profile-original" wx:if="{{remark && remark !== person.name}}">原名 {{person.name}}</view>
    <view class="profile-nickname" wx:if="{{person.nickname}}">也叫 {{person.nickname}}</view>
    <view class="pill {{circle.type === 'family' ? '' : 'class-pill'}}">{{relationLabel}}</view>
    <view class="profile-city" wx:if="{{person.city}}">⌖ {{person.city}}</view>
  </view>

  <view class="card remark-card" wx:if="{{!person.isSelf}}">
    <view class="remark-heading"><view class="section-title">备注名 <text class="remark-private">仅自己可见</text></view><button wx:if="{{!remarkEditing && !remarkLoading && !remarkError}}" class="remark-edit" bindtap="onEditRemark">{{remark ? '修改' : '添加'}}</button></view>
    <view class="remark-state" wx:if="{{remarkLoading}}">正在读取备注…</view>
    <view class="remark-state" wx:elif="{{remarkError}}">{{remarkError}}<button class="remark-edit" bindtap="loadRemark">重试</button></view>
    <view wx:elif="{{remarkEditing}}">
      <textarea class="remark-input" maxlength="200" value="{{remarkDraft}}" placeholder="例如：二姨、阿明；留空恢复原名" bindinput="onRemarkInput" disabled="{{remarkSaving}}" />
      <view class="remark-count">{{remarkDraft.length}} / 200</view>
      <view class="remark-actions"><button class="btn secondary" bindtap="onCancelRemark" disabled="{{remarkSaving}}">取消</button><button class="btn" bindtap="onSaveRemark" disabled="{{remarkSaving}}">{{remarkSaving ? '保存中…' : '保存备注'}}</button></view>
    </view>
    <view wx:else class="remark-text {{remark ? '' : 'remark-empty'}}">{{remark || '设置你熟悉的叫法，列表、地图和关系图都会显示。'}}</view>
  </view>

  <view class="card relation-card" wx:if="{{circle.type === 'family'}}">
    <view class="section-title">{{person.isSelf ? '这就是你' : relationStatus === 'resolved' ? '你可以叫 TA：' + relationLabel : '关系：' + relationLabel}}</view>
    <view class="relation-path">{{relationPath || '还没补全你们之间的家人关系'}}</view>
    <view class="missing" wx:if="{{relationMissing}}">还需补充：{{relationMissing}}</view>
    <view class="small muted" wx:if="{{alternatives}}">也可称：{{alternatives}}</view>
  </view>

  <view class="card details-card">
    <view class="section-title">{{person.isSelf ? '我的近况' : '现在的 TA'}}</view>
    <view class="detail-row" wx:for="{{rows}}" wx:key="label"><text class="detail-label">{{item.label}}</text><text class="detail-value">{{item.value}}</text></view>
    <view class="empty-details" wx:if="{{!rows.length}}">还没有填写更多资料。</view>
    <view class="update-time" wx:if="{{updated}}">{{updatedLabel}}：{{updated}}</view>
  </view>

  <view class="card contact-card" wx:if="{{person.phone || person.wechatId}}"><view class="section-title">{{person.isSelf ? '我的联系方式' : '联系 TA'}}</view><view class="detail-row" wx:if="{{person.phone}}"><text class="detail-label">手机号</text><text class="detail-value">{{person.phone}}</text><text class="text-action" bindtap="onCall">拨打</text></view><view class="detail-row" wx:if="{{person.wechatId}}"><text class="detail-label">微信号</text><text class="detail-value">{{person.wechatId}}</text><text class="text-action" bindtap="onCopyWechat">复制</text></view></view>

  <view class="profile-actions" wx:if="{{person.isSelf || canClaim}}"><button class="btn" wx:if="{{person.isSelf}}" bindtap="onEdit">编辑我的资料</button><button class="btn secondary" wx:if="{{canClaim}}" disabled="{{claimBusy}}" bindtap="onClaim">{{claimBusy ? '正在提交…' : '这是我'}}</button></view>
  <view class="small muted" wx:if="{{canClaim}}">如果这是你的资料，点一下，请管理员确认。</view>
  <view class="small muted" wx:if="{{claimPending && !person.isClaimed}}">已提交，等待管理员确认。</view>
</view>
<view class="page profile-page" wx:else><view class="card empty"><view>{{loading ? '正在读取资料…' : '暂时无法打开资料：' + loadError}}</view><button class="btn secondary" wx:if="{{!loading}}" bindtap="onRetry">重试</button><button class="btn ghost" bindtap="onHome">返回亲友录</button></view></view>
