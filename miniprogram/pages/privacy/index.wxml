<view class="page privacy-page" wx:if="{{person && !loading && !loadError}}">
  <view class="eyebrow">YOUR PRIVACY</view><view class="title">由你决定谁能看</view><view class="subtitle intro">以下设置只影响「{{person.name}}」在当前圈子的资料。另一个圈子有自己的设置。</view>
  <view class="card identity-card"><view class="row gap"><view class="avatar">{{initial}}</view><view><view class="person-name">{{person.name}}</view><view class="small muted">姓名和必要关系会向本圈成员展示</view></view></view></view>
  <view class="section-title block-title">资料可见范围</view>
  <view class="card settings-card"><view class="setting-row" wx:for="{{settings}}" wx:key="key"><view class="grow"><view class="strong">{{item.label}}</view><view class="small muted setting-desc">{{item.description}}</view><view class="visibility-label">{{item.shared ? '本圈已加入成员可见' : '仅自己可见'}}</view></view><switch checked="{{item.shared}}" disabled="{{saving}}" color="#258660" data-key="{{item.key}}" bindchange="onToggle" /></view></view>
  <button class="btn save-btn" disabled="{{saving}}" bindtap="onSave">{{saving ? '正在保存…' : '保存可见范围'}}</button>

  <view class="section-title block-title">长辈代维护</view>
  <view class="subtitle delegation-intro">可授权管理员长期帮你更新指定资料，也可分别授权多位。管理员不能更改你的可见范围，你可以随时撤销。</view>
  <view class="card" wx:if="{{admins.length}}"><view class="field-label">选择管理员</view><picker mode="selector" range="{{adminNames}}" value="{{adminIndex}}" bindchange="onAdmin"><view class="field-control">{{adminNames[adminIndex]}} ▾</view></picker><view class="field-label fields-label">允许代维护</view><checkbox-group bindchange="onDelegable"><label class="check-row" wx:for="{{delegable}}" wx:key="value"><checkbox value="{{item.value}}" color="#258660" /><text>{{item.label}}</text></label></checkbox-group><button class="btn secondary grant-btn" disabled="{{saving}}" bindtap="onGrant">{{saving ? '正在处理…' : '授权这位管理员'}}</button></view>
  <view class="card empty compact" wx:else>本圈还没有其他管理员。等圈主指定管理员后，就可以授权代维护。</view>
  <view class="card current-delegations" wx:if="{{delegations.length}}"><view class="strong current-title">正在生效的授权</view><view class="delegation-row" wx:for="{{delegations}}" wx:key="id"><view class="grow"><view class="person-name">{{item.adminName}}</view><view class="small muted">可更新：{{item.fieldNames}}</view></view><text class="revoke" data-id="{{item.id}}" bindtap="onRevoke">撤销</text></view></view>
</view>
<view class="page privacy-page" wx:else><view class="card empty"><view>{{loading ? '正在读取可见范围…' : '暂时无法打开可见范围：' + loadError}}</view><button class="btn secondary" wx:if="{{!loading}}" bindtap="onRetry">重试</button><button class="btn ghost" bindtap="onHome">返回我的圈子</button></view></view>
