.intro { margin: 16rpx 0 28rpx; }.review-numbers { display: flex; gap: 20rpx; margin: 20rpx 0; }.review-numbers view { flex: 1; border-radius: 19rpx; background: #f0f6ef; padding: 23rpx; }.number { font-size: 48rpx; font-weight: 750; color: #227251; display: block; }.number-label { font-size: 22rpx; color: #799080; display: block; }.create-invite { margin-top: 29rpx; }.invite-card { margin-top: 29rpx; }.invite-name { font-size: 36rpx; font-weight: 750; margin: 27rpx 0 6rpx; }.qr-placeholder { display: flex; align-items: center; flex-direction: column; padding: 30rpx 0; border-radius: 20rpx; background: #f7faf7; margin: 25rpx 0; }.qr-grid { display: grid; grid-template-columns: repeat(11, 11rpx); grid-template-rows: repeat(11, 11rpx); gap: 2rpx; padding: 16rpx; background: #fff; border: 2rpx solid #e0e9e1; }.qr-cell { background: transparent; }.qr-cell.on { background: #2b6047; }.qr-caption { color: #2b6047; font-weight: 700; margin-top: 12rpx; }.token-label { font-size: 22rpx; color: #83948a; }.token-box { margin: 10rpx 0 26rpx; border-radius: 13rpx; background: #f2f6f2; color: #355f49; font-size: 24rpx; padding: 18rpx; word-break: break-all; }.invite-card .btn { margin-top: 12rpx; }.revoke { margin: 27rpx auto; display: block; color: #b65654; font-size: 24rpx; text-align: center; }.demo-note { color: #82978a; background: #e9f1e9; border-radius: 17rpx; padding: 18rpx; font-size: 22rpx; line-height: 1.5; }
