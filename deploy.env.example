# Copy to .env, replace the domain, and point its DNS to your server.
PUBLIC_ORIGIN=https://kin.example.com
SITE_ADDRESS=kin.example.com
NODE_ENV=production
HTTP_PORT=80
HTTPS_PORT=443
# Empty uses the bundled public-domain overview map, with no external tile service.
# Optional: set a compatible WGS84 tile service and its required attribution.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
